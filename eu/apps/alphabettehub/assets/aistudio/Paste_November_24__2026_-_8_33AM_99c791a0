          <span>Config IA</span>
        </button>
      </div>
    </div>

    <!-- Barre de navigation à 3 onglets (WCAG ARIA Tablist) -->
    <nav class="max-w-5xl mx-auto px-2 sm:px-4 border-t" style="border-color: var(--border-color);" aria-label="Navigation principale">
      <div role="tablist" class="grid grid-cols-3 gap-1">
        <button role="tab" id="tab-passport" aria-controls="panel-passport" aria-selected="true" class="tab-btn px-2 py-3 text-center flex flex-col sm:flex-row items-center justify-center gap-1.5 rounded-t-lg">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
          <span class="text-sm sm:text-base leading-tight">Mon Passeport</span>
        </button>
        <button role="tab" id="tab-ideas" aria-controls="panel-ideas" aria-selected="false" class="tab-btn px-2 py-3 text-center flex flex-col sm:flex-row items-center justify-center gap-1.5 rounded-t-lg">
