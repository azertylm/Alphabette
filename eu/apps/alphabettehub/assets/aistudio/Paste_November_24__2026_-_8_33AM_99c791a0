          <span class="text-sm sm:text-base leading-tight">Boîte à Idées</span>
        </button>
        <button role="tab" id="tab-apps" aria-controls="panel-apps" aria-selected="false" class="tab-btn px-2 py-3 text-center flex flex-col sm:flex-row items-center justify-center gap-1.5 rounded-t-lg">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          <span class="text-sm sm:text-base leading-tight">Les Applis</span>
