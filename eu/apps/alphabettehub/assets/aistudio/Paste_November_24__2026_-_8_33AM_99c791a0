  <meta name="theme-color" content="#00449E">

  <!-- Police ultra-lisible Atkinson Hyperlegible (Braille Institute) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Génération de QR Code fiable en local (aucun serveur externe appelé) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    /* ==========================================================================
       1. DESIGN TOKENS & THÈMES WCAG AAA (APPLICATION EN TEMPS RÉEL)
       ========================================================================== */
    :root {
      --font-main: 'Atkinson Hyperlegible', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --letter-spacing: 0em;
      --word-spacing: 0em;
      --line-height: 1.55;
      --border-width: 1px;
      --radius-card: 1rem;
      --radius-btn: 0.75rem;
    }

    /* Tailles de texte fluides basées sur la racine HTML (adaptent tout Tailwind) */
    html[data-font-size="normal"] { font-size: 16px; }
    html[data-font-size="lg"]     { font-size: 20px; }
    html[data-font-size="xl"]     { font-size: 24px; }

    /* Confort Dys : espacement augmenté des lettres, mots et lignes */
    html[data-font-family="dyslexic"] {
      --letter-spacing: 0.08em;
      --word-spacing: 0.18em;
      --line-height: 1.85;
    }

    /* THÈME 1 : Clair Haute Visibilité (Contraste >= 9:1) */
    html[data-theme="light"] {
      --bg-page: #FFFFFF;
      --bg-surface: #F4F6F9;
      --bg-card: #FFFFFF;
      --bg-input: #FFFFFF;
      --text-primary: #0A0A0A;
      --text-secondary: #2D3748;
      --border-color: #CBD5E1;
      --border-strong: #64748B;
      --accent: #00449E;
      --accent-hover: #003070;
      --accent-text: #FFFFFF;
      --accent-soft: #E6F0FA;
      --accent-soft-text: #003580;
      --danger: #9B1C1C;
      --danger-soft: #FEF2F2;
      --success: #065F46;
      --success-soft: #ECFDF5;
      --focus-ring: #D97706;
      --shadow-card: 0 2px 8px rgba(10, 10, 10, 0.06);
    }

    /* THÈME 2 : Sombre Onyx (Contraste >= 10:1) */
    html[data-theme="onyx"] {
      --bg-page: #0E1117;
      --bg-surface: #161B22;
      --bg-card: #181D26;
      --bg-input: #0E1117;
      --text-primary: #F8FAFC;
      --text-secondary: #CBD5E1;
      --border-color: #30363D;
      --border-strong: #6E7681;
      --accent: #38BDF8;
      --accent-hover: #7DD3FC;
      --accent-text: #0A0A0A;
      --accent-soft: #1E293B;
      --accent-soft-text: #7DD3FC;
      --danger: #FCA5A5;
      --danger-soft: #450A0A;
      --success: #6EE7B7;
      --success-soft: #064E3B;
      --focus-ring: #FACC15;
      --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.4);
    }

    /* THÈME 3 : Contraste Maximum (Noir absolu, Blanc, Jaune #FFD700, 2px net) */
    html[data-theme="high-contrast"] {
      --bg-page: #000000;
      --bg-surface: #000000;
      --bg-card: #000000;
      --bg-input: #000000;
      --text-primary: #FFFFFF;
      --text-secondary: #FFD700;
      --border-color: #FFFFFF;
      --border-strong: #FFD700;
      --accent: #FFD700;
      --accent-hover: #FFFFFF;
      --accent-text: #000000;
      --accent-soft: #000000;
      --accent-soft-text: #FFD700;
      --danger: #FFD700;
      --danger-soft: #000000;
      --success: #FFD700;
      --success-soft: #000000;
      --focus-ring: #FFD700;
      --border-width: 2px;
      --shadow-card: none;
    }

    /* Application globale */
    body {
      font-family: var(--font-main);
      background-color: var(--bg-page);
      color: var(--text-primary);
      letter-spacing: var(--letter-spacing);
      word-spacing: var(--word-spacing);
      line-height: var(--line-height);
      overflow-x: hidden;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    /* Focus AAA ultra-visible au clavier */
    *:focus-visible {
      outline: 3px solid var(--focus-ring) !important;
      outline-offset: 3px !important;
    }

    /* Classes utilitaires liées aux variables */
    .surface-box {
      background-color: var(--bg-surface);
      border: var(--border-width) solid var(--border-color);
    }
    .card-box {
      background-color: var(--bg-card);
      border: var(--border-width) solid var(--border-color);
      box-shadow: var(--shadow-card);
      border-radius: var(--radius-card);
    }
    .text-muted { color: var(--text-secondary); }
    .input-aaa {
      background-color: var(--bg-input);
      color: var(--text-primary);
      border: 2px solid var(--border-strong);
      border-radius: var(--radius-btn);
    }
    .input-aaa:focus {
      border-color: var(--accent);
    }

    /* Boutons WCAG AAA : min 48x48px */
    .btn-aaa {
      min-height: 48px;
      min-width: 48px;
      border-radius: var(--radius-btn);
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.65rem 1.15rem;
      cursor: pointer;
      transition: transform 0.1s ease, background-color 0.15s ease, border-color 0.15s ease;
    }
    .btn-aaa:active { transform: scale(0.98); }

    .btn-primary {
      background-color: var(--accent);
      color: var(--accent-text);
      border: 2px solid var(--accent);
    }
    .btn-primary:hover {
      background-color: var(--accent-hover);
      border-color: var(--accent-hover);
    }

    .btn-secondary {
      background-color: var(--bg-card);
      color: var(--text-primary);
      border: 2px solid var(--border-strong);
    }
    .btn-secondary:hover {
      border-color: var(--accent);
      background-color: var(--accent-soft);
      color: var(--accent-soft-text);
    }

    .btn-option {
      background-color: var(--bg-card);
      color: var(--text-primary);
      border: 2px solid var(--border-color);
    }
    .btn-option[aria-pressed="true"] {
      background-color: var(--accent);
      color: var(--accent-text);
      border-color: var(--accent);
    }
    html[data-theme="high-contrast"] .btn-option[aria-pressed="true"] {
      border-color: #FFFFFF;
    }

    /* Onglets principaux */
    .tab-btn {
      min-height: 52px;
      font-weight: 700;
      border-bottom: 4px solid transparent;
      color: var(--text-secondary);
      transition: background-color 0.15s ease, color 0.15s ease;
    }
    .tab-btn[aria-selected="true"] {
      color: var(--text-primary);
      border-bottom-color: var(--accent);
      background-color: var(--accent-soft);
    }
    html[data-theme="high-contrast"] .tab-btn[aria-selected="true"] {
      color: #FFD700;
      border-bottom-color: #FFD700;
      border-top: 2px solid #FFD700;
    }

    /* Badge catégorie */
    .badge-aaa {
      background-color: var(--accent-soft);
      color: var(--accent-soft-text);
      border: var(--border-width) solid var(--border-color);
      border-radius: 9999px;
      padding: 0.2rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
    }

    /* Animation micro en écoute */
    @keyframes pulse-ring {
      0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
      70% { box-shadow: 0 0 0 12px rgba(220, 38, 38, 0); }
      100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
    }
    .mic-listening {
      animation: pulse-ring 1.3s infinite;
      background-color: #B91C1C !important;
      color: #FFFFFF !important;
      border-color: #FFFFFF !important;
    }

    /* Zone blanche obligatoire autour du QR Code pour scannabilité sur fond sombre */
    .qr-wrapper {
      background-color: #FFFFFF;
      padding: 1rem;
      border-radius: 0.75rem;
      border: 2px solid #0A0A0A;
      display: inline-block;
    }
    .qr-wrapper img, .qr-wrapper canvas {
      display: block;
      margin: 0 auto;
    }

    /* Lien d'évitement (Skip link) */
    .skip-link {
      position: absolute;
      top: -100px;
      left: 1rem;
      z-index: 100;
      background: var(--accent);
      color: var(--accent-text);
      padding: 0.75rem 1.25rem;
      border-radius: 0.5rem;
      font-weight: 700;
    }
    .skip-link:focus {
      top: 1rem;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Lien d'évitement pour lecteurs d'écran et navigation clavier -->
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <!-- Zone de notifications accessibles (Toast aria-live) -->
  <div id="toast-container" aria-live="polite" aria-atomic="true" class="fixed bottom-4 right-4 left-4 sm:left-auto sm:max-w-md z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- ========================================================================
       EN-TÊTE ÉCOSYSTÈME ALPHABETTE
       ======================================================================== -->
  <header class="surface-box sticky top-0 z-40">
    <div class="max-w-5xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
