                  </button>
                </div>
                <p class="text-muted">${escapeHtml(app.description)}</p>
              </div>
              <div class="pt-2">
                <button type="button" class="btn-aaa btn-primary w-full btn-open-app" data-id="${escapeHtml(app.id)}" data-url="${escapeHtml(fullUrl)}">
                  Ouvrir ${escapeHtml(app.name)} →
                </button>
              </div>
            </article>
          `;
        }).join('');

        // Écouteurs audio & lancement
        grid.querySelectorAll('.btn-speak-app').forEach(btn => {
          btn.addEventListener('click', () => {
            const app = ECOSYSTEM_APPS.find(a => a.id === btn.getAttribute('data-id'));
            if (app) speakText(`${app.name}, catégorie ${app.category}. ${app.description}`);
          });
        });

        grid.querySelectorAll('.btn-open-app').forEach(btn => {
          btn.addEventListener('click', () => {
            const app = ECOSYSTEM_APPS.find(a => a.id === btn.getAttribute('data-id'));
            const url = btn.getAttribute('data-url');
            if (!app) return;
            const banner = document.getElementById('app-launch-banner');
            document.getElementById('launch-app-title').textContent = `Ouverture de ${app.name}`;
            document.getElementById('launch-app-url').textContent = url;
            document.getElementById('launch-app-link').href = url;
            banner.classList.remove('hidden');
            banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            showToast(`Lien Passeport généré pour ${app.name} !`, 'success');
          });
        });
      }

      /* ======================================================================
         MODULE 8 : NAVIGATION PAR ONGLETS & MODALES ACCESSIBLES
         ====================================================================== */
      function switchTab(tabId) {
        activeTabId = tabId;
        const tabs = document.querySelectorAll('[role="tab"]');
        const panels = document.querySelectorAll('[role="tabpanel"]');

        tabs.forEach(t => {
          const isSelected = t.id === tabId;
          t.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        });

        panels.forEach(p => {
          const isTarget = p.getAttribute('aria-labelledby') === tabId;
          p.classList.toggle('hidden', !isTarget);
        });

        if (passport.autoRead) {
          const announcements = {
            'tab-passport': 'Onglet Mon Passeport Alphabette. Réglez la taille du texte, le contraste et la voix.',
            'tab-ideas': 'Onglet La Boîte à Idées Vivante. Dictez une idée ou votez pour les projets de la communauté.',
            'tab-apps': 'Onglet Les Applis Alphabette. Choisissez une application adaptée à votre passeport.'
          };
          speakText(announcements[tabId] || '');
        }
      }

      function setupEventListeners() {
        // Navigation par onglets
        document.querySelectorAll('[role="tab"]').forEach(tab => {
          tab.addEventListener('click', () => switchTab(tab.id));
        });

        // Lecture globale de la page active
        document.getElementById('btn-read-page').addEventListener('click', () => {
          if (isSpeaking) {
            stopSpeaking();
            return;
          }
          const activePanel = document.querySelector(`[role="tabpanel"][aria-labelledby="${activeTabId}"]`);
          if (activePanel) {
            speakText(activePanel.innerText.replace(/\s+/g, ' ').slice(0, 1200));
          }
        });

        // Préférences du Passeport
        document.querySelectorAll('[data-pref]').forEach(btn => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-pref');
            let val = btn.getAttribute('data-value');
            if (key === 'speechRate') val = Number(val);
            passport[key] = val;
            applyPassportToUI();
          });
        });

        // Interrupteur auto-lecture
        document.getElementById('toggle-autoread').addEventListener('click', () => {
          passport.autoRead = !passport.autoRead;
          applyPassportToUI();
          if (passport.autoRead) {
            speakText('Lecture automatique activée.');
          }
        });

        // Test TTS Aperçu
        document.getElementById('btn-test-tts').addEventListener('click', () => {
          speakText('Bonjour ! Voici votre confort de lecture Alphabette. Les réglages de votre passeport sont prêts.');
        });

        // Copier lien Passeport
        document.getElementById('btn-copy-passport').addEventListener('click', () => {
          copyTextToClipboard(getPassportSyncUrl(), 'Lien Passeport copié ! Ouvrez-le sur un autre appareil.');
        });

        // Réinitialisation Passeport (inline sans confirm())
        const resetBox = document.getElementById('reset-confirm-box');
        document.getElementById('btn-reset-passport').addEventListener('click', () => {
          resetBox.classList.toggle('hidden');
        });
        document.getElementById('btn-reset-no').addEventListener('click', () => {
          resetBox.classList.add('hidden');
        });
        document.getElementById('btn-reset-yes').addEventListener('click', () => {
          passport = { ...DEFAULT_PASSPORT };
          applyPassportToUI();
          resetBox.classList.add('hidden');
          showToast('Passeport réinitialisé aux valeurs par défaut.', 'info');
        });

        // Dictée vocale Idée
        document.getElementById('btn-mic-idea').addEventListener('click', () => {
          startVoiceDictation(
            document.getElementById('idea-input'),
            document.getElementById('btn-mic-idea'),
            document.getElementById('btn-mic-idea-label'),
            'Dicter mon idée'
          );
        });

        // Transformation en Fiche Produit par l'IA
        document.getElementById('btn-generate-idea').addEventListener('click', async () => {
          const input = document.getElementById('idea-input').value.trim();
          if (!input) {
            showToast('Dictez ou écrivez d\'abord votre idée en une phrase.', 'error');
            document.getElementById('idea-input').focus();
            return;
          }
          const btn = document.getElementById('btn-generate-idea');
          const origHtml = btn.innerHTML;
          btn.disabled = true;
          btn.textContent = '⏳ Analyse IA en cours...';

          try {
            const sheet = await generateProductSheet(input);
            document.getElementById('draft-name').value = sheet.name || 'Nouvelle Idée';
            document.getElementById('draft-target').value = sheet.target || 'Tout public';
            document.getElementById('draft-problem').value = sheet.problem || input;
            document.getElementById('draft-features').value = (sheet.features || []).join('\n');
            document.getElementById('idea-draft-box').classList.remove('hidden');
            showToast('Fiche Produit générée ! Vous pouvez l\'ajuster ou la publier.', 'success');
          } catch (err) {
            showToast(`Erreur IA : ${err.message}. Passage en Mode Démo.`, 'error');
            const fallback = demoGenerateProductSheet(input);
            document.getElementById('draft-name').value = fallback.name;
            document.getElementById('draft-target').value = fallback.target;
            document.getElementById('draft-problem').value = fallback.problem;
            document.getElementById('draft-features').value = fallback.features.join('\n');
            document.getElementById('idea-draft-box').classList.remove('hidden');
          } finally {
            btn.disabled = false;
            btn.innerHTML = origHtml;
          }
        });

        // Écouter le brouillon de fiche
        document.getElementById('btn-listen-draft').addEventListener('click', () => {
          const name = document.getElementById('draft-name').value;
          const target = document.getElementById('draft-target').value;
          const problem = document.getElementById('draft-problem').value;
          const features = document.getElementById('draft-features').value;
          speakText(`Fiche produit : ${name}. Public cible : ${target}. Problème résolu : ${problem}. Fonctionnalités clés : ${features}`);
        });

        // Publier dans la Boîte à Idées
        document.getElementById('btn-publish-idea').addEventListener('click', () => {
          const name = document.getElementById('draft-name').value.trim();
          const target = document.getElementById('draft-target').value.trim();
          const problem = document.getElementById('draft-problem').value.trim();
          const features = document.getElementById('draft-features').value
            .split('\n')
            .map(l => l.trim())
            .filter(Boolean);

          if (!name || !problem) {
            showToast('Veuillez renseigner au moins un nom et le problème résolu.', 'error');
            return;
          }

          const newId = 'idea-' + Date.now();
          ideas.unshift({
            id: newId,
            name,
            target: target || 'Tout public',
            problem,
            features: features.length ? features : ['Interface accessible WCAG AAA'],
            votes: 1,
            createdAt: Date.now()
          });
          userVotes.push(newId);
          saveIdeasAndVotes();
          renderIdeas();

          document.getElementById('idea-input').value = '';
          document.getElementById('idea-draft-box').classList.add('hidden');
          showToast(`"${name}" a été publiée dans la Boîte à Idées !`, 'success');
        });

        document.getElementById('btn-cancel-draft').addEventListener('click', () => {
          document.getElementById('idea-draft-box').classList.add('hidden');
        });

        // Tri des idées
        document.querySelectorAll('[data-sort]').forEach(btn => {
          btn.addEventListener('click', () => {
            currentIdeaSort = btn.getAttribute('data-sort');
            document.querySelectorAll('[data-sort]').forEach(b => {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
            renderIdeas();
          });
        });

        // Filtres Applis
        document.querySelectorAll('[data-cat]').forEach(btn => {
          btn.addEventListener('click', () => {
            currentAppCategory = btn.getAttribute('data-cat');
            document.querySelectorAll('[data-cat]').forEach(b => {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
            renderApps();
          });
        });

        // Bannière de lancement d'appli
        document.getElementById('btn-close-launch').addEventListener('click', () => {
          document.getElementById('app-launch-banner').classList.add('hidden');
        });
        document.getElementById('btn-copy-launch-url').addEventListener('click', () => {
          const url = document.getElementById('launch-app-url').textContent;
          copyTextToClipboard(url, 'Lien d\'application avec Passeport copié !');
        });

        // Modale Config IA
        const modalAI = document.getElementById('modal-ai-config');
        const keyContainer = document.getElementById('ai-key-container');
        const keyInput = document.getElementById('ai-api-key');

        document.getElementById('btn-open-ai-config').addEventListener('click', () => {
          document.querySelectorAll('input[name="ai-provider"]').forEach(r => {
            r.checked = r.value === aiConfig.provider;
          });
          keyInput.value = aiConfig.apiKey || '';
          keyContainer.classList.toggle('hidden', aiConfig.provider === 'demo');
          modalAI.classList.remove('hidden');
        });

        document.querySelectorAll('input[name="ai-provider"]').forEach(radio => {
          radio.addEventListener('change', (e) => {
            keyContainer.classList.toggle('hidden', e.target.value === 'demo');
          });
        });

        document.getElementById('btn-close-ai-config').addEventListener('click', () => {
          modalAI.classList.add('hidden');
        });

        document.getElementById('btn-save-ai-config').addEventListener('click', () => {
          const selected = document.querySelector('input[name="ai-provider"]:checked').value;
          aiConfig = {
            provider: selected,
            apiKey: selected === 'demo' ? '' : keyInput.value.trim()
          };
          try {
            localStorage.setItem(STORAGE_KEYS.AI_CONFIG, JSON.stringify(aiConfig));
          } catch (e) { /* ignore */ }
          updateAIBadge();
          modalAI.classList.add('hidden');
          showToast('Configuration IA enregistrée localement.', 'success');
        });

        // Modale Signalement de bug
        const modalBug = document.getElementById('modal-bug');
        document.getElementById('btn-open-bug-modal').addEventListener('click', () => {
          modalBug.classList.remove('hidden');
          document.getElementById('bug-input').focus();
        });
        document.getElementById('btn-close-bug-modal').addEventListener('click', () => {
          modalBug.classList.add('hidden');
        });
        document.getElementById('btn-mic-bug').addEventListener('click', () => {
          startVoiceDictation(
            document.getElementById('bug-input'),
            document.getElementById('btn-mic-bug'),
            document.getElementById('btn-mic-bug-label'),
            'Dicter le souci'
          );
        });
        document.getElementById('btn-generate-bug').addEventListener('click', async () => {
          const raw = document.getElementById('bug-input').value.trim();
          if (!raw) {
            showToast('Décrivez ou dictez d\'abord le problème rencontré.', 'error');
            return;
          }
          const btn = document.getElementById('btn-generate-bug');
          btn.disabled = true;
          btn.textContent = '⏳ Formatage en cours...';
          try {
            const ticket = await generateBugTicket(raw);
            document.getElementById('bug-ticket-output').value = ticket;
            document.getElementById('btn-email-ticket').href = `mailto:support@alphabette.eu?subject=${encodeURIComponent('[Bug Alphabette] Signalement utilisateur')}&body=${encodeURIComponent(ticket)}`;
            document.getElementById('bug-result-box').classList.remove('hidden');
            showToast('Ticket technique formaté avec succès !', 'success');
          } catch (err) {
            const fallback = demoGenerateBugTicket(raw);
            document.getElementById('bug-ticket-output').value = fallback;
            document.getElementById('btn-email-ticket').href = `mailto:support@alphabette.eu?subject=${encodeURIComponent('[Bug Alphabette] Signalement utilisateur')}&body=${encodeURIComponent(fallback)}`;
            document.getElementById('bug-result-box').classList.remove('hidden');
            showToast('Ticket généré via le mode démo local.', 'info');
          } finally {
            btn.disabled = false;
            btn.textContent = '🛠️ Formater le ticket technique';
          }
        });

        document.getElementById('btn-copy-ticket').addEventListener('click', () => {
          copyTextToClipboard(document.getElementById('bug-ticket-output').value, 'Ticket technique copié !');
        });

        // Fermeture des modales avec la touche Échap
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            modalAI.classList.add('hidden');
            modalBug.classList.add('hidden');
          }
        });
      }

      /* ======================================================================
         INITIALISATION AU CHARGEMENT
         ====================================================================== */
      window.addEventListener('DOMContentLoaded', () => {
        loadPassport();
        loadAIConfig();
        loadIdeasAndVotes();
        applyPassportToUI();
        renderIdeas();
        renderApps();
        setupEventListeners();
      });
    })();
  </script>
</body>
</html>
