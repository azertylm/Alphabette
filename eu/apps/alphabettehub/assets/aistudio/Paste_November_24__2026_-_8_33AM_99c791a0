      function loadIdeasAndVotes() {
        try {
          const savedIdeas = localStorage.getItem(STORAGE_KEYS.IDEAS);
          ideas = savedIdeas ? JSON.parse(savedIdeas) : [...DEFAULT_IDEAS];
          const savedVotes = localStorage.getItem(STORAGE_KEYS.VOTES);
          userVotes = savedVotes ? JSON.parse(savedVotes) : [];
        } catch (e) {
          ideas = [...DEFAULT_IDEAS];
          userVotes = [];
        }
      }

      function saveIdeasAndVotes() {
        try {
          localStorage.setItem(STORAGE_KEYS.IDEAS, JSON.stringify(ideas));
          localStorage.setItem(STORAGE_KEYS.VOTES, JSON.stringify(userVotes));
        } catch (e) { /* ignore */ }
      }

      function toggleVote(ideaId) {
        const idea = ideas.find(i => i.id === ideaId);
        if (!idea) return;

        const idx = userVotes.indexOf(ideaId);
        if (idx === -1) {
          userVotes.push(ideaId);
          idea.votes += 1;
          showToast(`Vote enregistré pour "${idea.name}" !`, 'success');
        } else {
          userVotes.splice(idx, 1);
          idea.votes = Math.max(0, idea.votes - 1);
          showToast(`Vote retiré pour "${idea.name}".`, 'info');
        }
        saveIdeasAndVotes();
        renderIdeas();
      }

