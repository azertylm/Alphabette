      /* ======================================================================
         MODULE 4 : WEB SPEECH API (SYNTHÈSE VOCALE TTS & DICTÉE VOCALE STT)
         ====================================================================== */
      function stopSpeaking() {
        if ('speechSynthesis' in window) {
          window.speechSynthesis.cancel();
        }
        isSpeaking = false;
        const label = document.getElementById('btn-read-page-label');
        if (label) label.textContent = 'Lire';
      }

      function speakText(text) {
        if (!('speechSynthesis' in window)) {
          showToast('La synthèse vocale n\'est pas supportée par ce navigateur.', 'error');
          return;
        }
        stopSpeaking();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'fr-FR';
        utterance.rate = passport.speechRate || 1;
        utterance.onstart = () => {
          isSpeaking = true;
          document.getElementById('btn-read-page-label').textContent = 'Stop';
        };
        utterance.onend = () => {
          isSpeaking = false;
          document.getElementById('btn-read-page-label').textContent = 'Lire';
        };
        utterance.onerror = () => {
          isSpeaking = false;
          document.getElementById('btn-read-page-label').textContent = 'Lire';
        };
        window.speechSynthesis.speak(utterance);
      }

      function startVoiceDictation(targetTextarea, buttonEl, labelEl, defaultLabel) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) {
          showToast('La dictée vocale nécessite Chrome, Edge ou Safari récent. Vous pouvez saisir votre texte au clavier.', 'error');
          return;
        }

        const recognition = new SpeechRecognition();
        recognition.lang = 'fr-FR';
        recognition.interimResults = false;
        recognition.maxAlternatives = 1;

        buttonEl.classList.add('mic-listening');
        labelEl.textContent = 'Écoute en cours...';

        recognition.onresult = (event) => {
          const transcript = event.results[0][0].transcript;
          const existing = targetTextarea.value.trim();
          targetTextarea.value = existing ? `${existing} ${transcript}` : transcript;
          targetTextarea.focus();
          showToast('Dictée vocale ajoutée !', 'success');
        };

        recognition.onerror = () => {
          showToast('Micro non détecté ou autorisation refusée.', 'error');
        };

        recognition.onend = () => {
          buttonEl.classList.remove('mic-listening');
          labelEl.textContent = defaultLabel;
        };

        try {
          recognition.start();
        } catch (e) {
          buttonEl.classList.remove('mic-listening');
          labelEl.textContent = defaultLabel;
        }
      }

