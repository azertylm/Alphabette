        const contextInfo = `Contexte Passeport: thème=${passport.theme}, texte=${passport.fontSize}, police=${passport.fontFamily}, écran=${window.innerWidth}x${window.innerHeight}.`;
        const prompt = `Formate un ticket technique propre en français (Appli concernée, Gravité, Étapes de reproduction, Contexte Passeport) à partir de ce signalement vocal : "${rawText}". ${contextInfo}`;

        if (aiConfig.provider === 'gemini') {
          const apiKey = aiConfig.apiKey || '';
          const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
          const res = await fetchWithRetry(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
          });
          const data = await res.json();
          return data?.candidates?.[0]?.content?.parts?.[0]?.text || demoGenerateBugTicket(rawText);
        }

        if (aiConfig.provider === 'mistral') {
          if (!aiConfig.apiKey) throw new Error('Clé API Mistral manquante dans Config IA.');
          const res = await fetchWithRetry('https://api.mistral.ai/v1/chat/completions', {
