      /* ======================================================================
         MODULE 3 : PASSEPORT ALPHABETTE (SYNC URL, QR CODE, RENDU TEMPS RÉEL)
         ====================================================================== */
      function sanitizePassport(raw) {
        if (!raw || typeof raw !== 'object') return { ...DEFAULT_PASSPORT };
        return {
          version: 1,
          fontSize: ['normal', 'lg', 'xl'].includes(raw.fontSize) ? raw.fontSize : 'normal',
          theme: ['light', 'onyx', 'high-contrast'].includes(raw.theme) ? raw.theme : 'light',
          fontFamily: ['standard', 'dyslexic'].includes(raw.fontFamily) ? raw.fontFamily : 'standard',
          speechRate: [0.8, 1, 1.25].includes(Number(raw.speechRate)) ? Number(raw.speechRate) : 1,
          autoRead: Boolean(raw.autoRead)
        };
      }

      function loadPassport() {
        // 1. Vérifier si un ?passport= existe dans l'URL
        const params = new URLSearchParams(window.location.search);
        const urlPassport = params.get('passport');
        if (urlPassport) {
          try {
            const decoded = decodeBase64Unicode(urlPassport);
            passport = sanitizePassport(decoded);
            localStorage.setItem(STORAGE_KEYS.PASSPORT, JSON.stringify(passport));
            // Nettoyer l'URL sans recharger la page
            const cleanUrl = window.location.pathname;
            window.history.replaceState({}, document.title, cleanUrl);
            showToast('✅ Passeport Alphabette synchronisé depuis votre lien !', 'success');
            return;
          } catch (e) {
            showToast('Le lien Passeport détecté est invalide. Réglages locaux conservés.', 'error');
          }
        }

        // 2. Sinon charger depuis localStorage
        try {
          const saved = localStorage.getItem(STORAGE_KEYS.PASSPORT);
          if (saved) {
            passport = sanitizePassport(JSON.parse(saved));
          }
        } catch (e) {
          passport = { ...DEFAULT_PASSPORT };
        }
      }

      function getPassportSyncUrl() {
        const encoded = encodeBase64Unicode(passport);
        const base = window.location.origin && window.location.origin !== 'null'
          ? window.location.origin + window.location.pathname
          : 'https://alphabette.eu/hub';
        return `${base}?passport=${encoded}`;
      }

      function renderQRCode(url) {
        const container = document.getElementById('qrcode-container');
