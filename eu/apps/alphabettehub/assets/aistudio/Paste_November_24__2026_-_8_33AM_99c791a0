        const listEl = document.getElementById('ideas-list');
        document.getElementById('ideas-count').textContent = ideas.length;

        const sorted = [...ideas].sort((a, b) => {
          if (currentIdeaSort === 'recent') return b.createdAt - a.createdAt;
          return b.votes - a.votes;
        });

        listEl.innerHTML = sorted.map(idea => {
          const hasVoted = userVotes.includes(idea.id);
          const featuresHtml = (idea.features || [])
            .map(f => `<li class="flex items-start gap-2"><span aria-hidden="true">•</span><span>${escapeHtml(f)}</span></li>`)
            .join('');

          return `
