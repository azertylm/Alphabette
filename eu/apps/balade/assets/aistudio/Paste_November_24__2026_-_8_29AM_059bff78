<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="theme-color" content="#09090B" />
  <meta name="description" content="Curioz par Alphabette — Compagnon de curiosité tout-en-un : balades culturelles audio, détective d'objets et prof socratique." />
  <title>Curioz — Alphabette</title>

  <!-- Police Inter pour une lisibilité optimale WCAG AAA -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          },
          colors: {
            onyx: {
              bg: '#09090B',
              card: '#18181B',
              border: '#27272A',
              muted: '#A1A1AA',
            }
          }
        }
      }
    };
  </script>

  <style>
    /* Styles complémentaires pour l'accessibilité et les animations douces */
    html, body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      -webkit-tap-highlight-color: transparent;
      overscroll-behavior-y: none;
    }

    /* Focus visible haute visibilité (WCAG AAA) */
    *:focus-visible {
      outline: 3px solid #38BDF8;
      outline-offset: 2px;
    }

    /* Animation onde vocale pour le micro */
    @keyframes pulseRing {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 14px rgba(244, 63, 94, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
    }
    .recording-pulse {
      animation: pulseRing 1.4s infinite;
    }

    /* Masquer les barres de défilement sur les filtres horizontaux */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Styles d'impression propres pour l'export du Carnet */
    @media print {
      header, nav, .no-print { display: none !important; }
      body { background: #FFFFFF !important; color: #000000 !important; }
      main { padding: 0 !important; margin: 0 !important; max-width: 100% !important; }
      .print-card { break-inside: avoid; border: 2px solid #000 !important; background: #FFF !important; color: #000 !important; margin-bottom: 16px; }
    }
  </style>
</head>
<body class="bg-white text-black dark:bg-onyx-bg dark:text-white min-h-screen flex flex-col transition-colors duration-200 selection:bg-indigo-500 selection:text-white">

  <!-- ==================== HEADER FIXE ==================== -->
  <header class="sticky top-0 z-40 bg-white/95 dark:bg-onyx-bg/95 backdrop-blur-md border-b-2 border-zinc-200 dark:border-onyx-border px-4 py-3">
    <div class="max-w-2xl mx-auto flex items-center justify-between gap-2">
      <!-- Logo & Nom -->
      <div class="flex items-center gap-3">
        <div id="brandBadge" class="w-11 h-11 rounded-2xl bg-emerald-600 dark:bg-emerald-500 flex items-center justify-center text-white font-black text-xl shadow-md transition-colors">
          C
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-xl font-black tracking-tight leading-none">Curioz</h1>
            <span id="modeBadge" class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-zinc-200 text-zinc-900 dark:bg-zinc-800 dark:text-emerald-400">
              Démo
            </span>
          </div>
          <p class="text-xs font-semibold text-zinc-600 dark:text-zinc-400 mt-0.5">par Alphabette</p>
        </div>
      </div>

      <!-- Actions Header : Switch Thème & Paramètres -->
      <div class="flex items-center gap-2">
        <button
          id="btnThemeToggle"
          type="button"
          aria-label="Basculer entre le mode Onyx et le mode Clarté"
          class="min-w-[48px] min-h-[48px] px-3 rounded-2xl border-2 border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-onyx-card hover:bg-zinc-200 dark:hover:bg-zinc-800 flex items-center justify-center gap-2 font-bold text-sm transition"
        >
          <span id="themeIcon" aria-hidden="true">☀️</span>
          <span id="themeLabel" class="hidden sm:inline">Clarté</span>
        </button>

        <button
          id="btnOpenSettings"
          type="button"
          aria-label="Ouvrir les paramètres IA et voix"
          class="min-w-[48px] min-h-[48px] rounded-2xl border-2 border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-onyx-card hover:bg-zinc-200 dark:hover:bg-zinc-800 flex items-center justify-center text-xl transition"
        >
          ⚙️
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== CONTENU PRINCIPAL ==================== -->
  <main class="flex-1 w-full max-w-2xl mx-auto px-4 pt-5 pb-28">

    <!-- ==================== ONGLET 1 : BALADE (L'OREILLE LOCALE) ==================== -->
    <section id="tab-balade" class="tab-panel space-y-5" aria-labelledby="heading-balade">
      <div class="rounded-3xl p-5 border-2 border-emerald-600/30 dark:border-emerald-500/40 bg-emerald-50/70 dark:bg-onyx-card">
        <div class="flex items-center justify-between gap-2 mb-2">
          <span class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-emerald-700 text-white dark:bg-emerald-500 dark:text-black">
            🧭 L'Oreille Locale
          </span>
          <span class="text-xs font-bold text-emerald-900 dark:text-emerald-300">Audio-guide IA</span>
        </div>
        <h2 id="heading-balade" class="text-2xl font-black tracking-tight mb-1">Écoutez les secrets autour de vous</h2>
        <p class="text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-4">
          Géolocalisez-vous ou saisissez un lieu pour découvrir une histoire insolite, une légende ou un détail d'architecture.
        </p>

        <!-- Bouton géant Géolocalisation -->
        <button
          id="btnGeolocate"
          type="button"
          class="w-full min-h-[56px] rounded-2xl bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-400 dark:hover:bg-emerald-300 text-white dark:text-black font-extrabold text-base px-5 py-3.5 flex items-center justify-center gap-2.5 shadow-lg transition active:scale-[0.98]"
        >
          <span class="text-xl" aria-hidden="true">📍</span>
          <span>Me géolocaliser maintenant</span>
        </button>

        <!-- Séparateur -->
        <div class="flex items-center gap-3 my-4">
          <div class="h-0.5 flex-1 bg-emerald-200 dark:bg-zinc-800"></div>
          <span class="text-xs font-bold uppercase text-zinc-600 dark:text-zinc-400">ou saisir un lieu</span>
          <div class="h-0.5 flex-1 bg-emerald-200 dark:bg-zinc-800"></div>
        </div>

        <!-- Saisie manuelle -->
        <div class="flex flex-col sm:flex-row gap-2">
          <input
            id="inputLocation"
            type="text"
            placeholder="Ex : La Grande-Motte, Lille, Paris..."
            class="flex-1 min-h-[52px] px-4 rounded-2xl border-2 border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950 text-black dark:text-white font-semibold placeholder:text-zinc-500"
          />
          <button
            id="btnSearchLocation"
            type="button"
            class="min-h-[52px] px-5 rounded-2xl bg-black dark:bg-white text-white dark:text-black font-extrabold text-sm hover:opacity-90 transition active:scale-[0.98]"
          >
            Explorer
          </button>
        </div>

        <!-- Raccourcis rapides -->
        <div class="flex flex-wrap gap-2 mt-3">
          <button type="button" data-quick-loc="La Grande-Motte" class="quick-loc min-h-[40px] px-3.5 py-1.5 rounded-xl text-xs font-bold border-2 border-emerald-700/30 dark:border-emerald-500/40 bg-white dark:bg-zinc-900 hover:bg-emerald-100 dark:hover:bg-emerald-950 transition">
            🏖️ La Grande-Motte
          </button>
          <button type="button" data-quick-loc="Lille - Wazemmes" class="quick-loc min-h-[40px] px-3.5 py-1.5 rounded-xl text-xs font-bold border-2 border-emerald-700/30 dark:border-emerald-500/40 bg-white dark:bg-zinc-900 hover:bg-emerald-100 dark:hover:bg-emerald-950 transition">
            🧱 Lille - Wazemmes
          </button>
          <button type="button" data-quick-loc="Montmartre, Paris" class="quick-loc min-h-[40px] px-3.5 py-1.5 rounded-xl text-xs font-bold border-2 border-emerald-700/30 dark:border-emerald-500/40 bg-white dark:bg-zinc-900 hover:bg-emerald-100 dark:hover:bg-emerald-950 transition">
            🗼 Montmartre
          </button>
        </div>
      </div>

      <!-- Résultat Capsule Balade -->
      <div id="baladeResult" class="hidden rounded-3xl p-5 border-2 border-zinc-200 dark:border-onyx-border bg-white dark:bg-onyx-card shadow-sm space-y-4">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p id="baladeLocTag" class="text-xs font-extrabold uppercase tracking-wider text-emerald-700 dark:text-emerald-400"></p>
            <h3 id="baladeTitle" class="text-xl font-black mt-1"></h3>
          </div>
          <span class="text-2xl" aria-hidden="true">🎧</span>
        </div>
        <p id="baladeText" class="text-base leading-relaxed font-medium text-zinc-900 dark:text-zinc-100 whitespace-pre-line"></p>

        <!-- Barre audio & sauvegarde -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t-2 border-zinc-100 dark:border-zinc-800">
          <button id="btnBaladeSpeak" type="button" class="min-h-[48px] px-4 rounded-xl bg-emerald-700 dark:bg-emerald-400 text-white dark:text-black font-extrabold text-sm flex items-center gap-2">
            🔊 Écouter
          </button>
          <button id="btnBaladeStop" type="button" class="min-h-[48px] px-4 rounded-xl border-2 border-zinc-300 dark:border-zinc-700 font-bold text-sm flex items-center gap-1.5">
            ⏹️ Stop
          </button>
          <button id="btnBaladeSave" type="button" class="min-h-[48px] px-4 rounded-xl border-2 border-emerald-700 dark:border-emerald-400 text-emerald-800 dark:text-emerald-300 font-extrabold text-sm ml-auto">
            ⭐ Sauvegarder
          </button>
        </div>
      </div>

      <!-- Bouton Déposer une anecdote -->
      <div class="rounded-3xl p-5 border-2 border-dashed border-emerald-600/50 dark:border-emerald-500/50 bg-white dark:bg-onyx-card/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h3 class="font-extrabold text-base">Vous connaissez un secret local ?</h3>
          <p class="text-sm text-zinc-700 dark:text-zinc-400">Dictez votre propre anecdote pour l'archiver dans votre Carnet.</p>
        </div>
        <button
          id="btnOpenAnecdote"
          type="button"
          class="w-full sm:w-auto min-h-[52px] px-5 rounded-2xl bg-zinc-900 dark:bg-zinc-100 text-white dark:text-black font-extrabold text-sm whitespace-nowrap"
        >
          🎙️ Déposer une anecdote
        </button>
      </div>
    </section>

    <!-- ==================== ONGLET 2 : SCANNER (DÉTECTIVE D'OBJET) ==================== -->
    <section id="tab-scanner" class="tab-panel hidden space-y-5" aria-labelledby="heading-scanner">
      <div class="rounded-3xl p-5 border-2 border-amber-500/40 bg-amber-50/70 dark:bg-onyx-card space-y-4">
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-amber-600 text-white dark:bg-amber-400 dark:text-black">
            🔎 Détective d'Objet
          </span>
          <span class="text-xs font-bold text-amber-900 dark:text-amber-300">Vision IA</span>
        </div>
        <div>
          <h2 id="heading-scanner" class="text-2xl font-black tracking-tight mb-1">Identifiez n'importe quel objet</h2>
          <p class="text-sm font-medium text-zinc-700 dark:text-zinc-300">
            Objet de brocante, plante, outil mystérieux ou monument : prenez une photo et choisissez votre niveau d'explication.
          </p>
        </div>

        <!-- Sélecteur de niveau de vulgarisation -->
        <div>
          <p class="text-xs font-extrabold uppercase tracking-wider text-zinc-700 dark:text-zinc-400 mb-2">Niveau d'explication :</p>
          <div class="grid grid-cols-3 gap-2" role="radiogroup" aria-label="Niveau de vulgarisation">
            <button type="button" data-level="enfant" class="level-btn min-h-[48px] rounded-xl font-extrabold text-xs sm:text-sm border-2 transition px-2">
              🎈 Enfant 10 ans
            </button>
            <button type="button" data-level="public" class="level-btn min-h-[48px] rounded-xl font-extrabold text-xs sm:text-sm border-2 transition px-2">
              👀 Grand Public
            </button>
            <button type="button" data-level="expert" class="level-btn min-h-[48px] rounded-xl font-extrabold text-xs sm:text-sm border-2 transition px-2">
              🎓 Expert
            </button>
          </div>
        </div>

        <!-- Zone Capture / Import Photo -->
        <label
          for="scannerFileInput"
          class="block cursor-pointer rounded-2xl border-2 border-dashed border-amber-600 dark:border-amber-400 bg-white dark:bg-zinc-950 p-5 text-center hover:bg-amber-50 dark:hover:bg-zinc-900 transition"
        >
          <input id="scannerFileInput" type="file" accept="image/*" capture="environment" class="sr-only" />
          <div id="scannerPlaceholder" class="space-y-2 py-3">
            <div class="text-4xl" aria-hidden="true">📸</div>
            <p class="font-extrabold text-base">Prendre une photo ou importer</p>
            <p class="text-xs font-medium text-zinc-600 dark:text-zinc-400">Appareil photo mobile ou galerie</p>
          </div>
          <img id="scannerPreview" alt="Aperçu de l'objet à analyser" class="hidden max-h-64 mx-auto rounded-xl object-contain border border-zinc-200 dark:border-zinc-800" />
        </label>

        <!-- Boutons Analyser & Démo -->
        <div class="flex flex-col sm:flex-row gap-2">
          <button
            id="btnAnalyzeObject"
            type="button"
            class="flex-1 min-h-[54px] rounded-2xl bg-amber-600 hover:bg-amber-700 dark:bg-amber-400 dark:hover:bg-amber-300 text-white dark:text-black font-extrabold text-base px-5 flex items-center justify-center gap-2 shadow-md transition active:scale-[0.98]"
          >
            ✨ Analyser cet objet
          </button>
          <button
            id="btnScannerDemoSample"
            type="button"
            class="min-h-[54px] px-4 rounded-2xl border-2 border-amber-700/40 dark:border-amber-400/50 font-extrabold text-sm hover:bg-amber-100 dark:hover:bg-zinc-800 transition"
          >
            🎲 Tester un objet mystère
          </button>
        </div>
      </div>

      <!-- Résultat Fiche Objet -->
      <div id="scannerResult" class="hidden rounded-3xl p-5 border-2 border-zinc-200 dark:border-onyx-border bg-white dark:bg-onyx-card shadow-sm space-y-4">
        <div class="flex items-start justify-between gap-2">
          <div>
            <span id="scanLevelBadge" class="inline-block text-xs font-extrabold uppercase px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 dark:bg-amber-500/20 dark:text-amber-300 mb-1"></span>
            <h3 id="scanName" class="text-2xl font-black"></h3>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="p-3.5 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
            <p class="text-xs font-extrabold uppercase text-zinc-600 dark:text-zinc-400">⏳ Époque & Origine</p>
            <p id="scanOrigin" class="font-bold text-sm mt-1"></p>
          </div>
          <div class="p-3.5 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
            <p class="text-xs font-extrabold uppercase text-zinc-600 dark:text-zinc-400">🛠️ Usage concret</p>
            <p id="scanUsage" class="font-bold text-sm mt-1"></p>
          </div>
        </div>

        <!-- Encart décalé : Petite histoire imaginaire -->
        <div class="p-4 rounded-2xl bg-amber-100/80 dark:bg-amber-500/10 border-2 border-amber-400/60 dark:border-amber-400/40">
          <p class="text-xs font-black uppercase tracking-wider text-amber-900 dark:text-amber-300 mb-1">
            🎭 La petite histoire imaginaire de cet objet
          </p>
          <p id="scanStory" class="text-sm font-medium leading-relaxed text-zinc-900 dark:text-zinc-100 italic"></p>
        </div>

        <!-- Actions TTS & Carnet -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t-2 border-zinc-100 dark:border-zinc-800">
          <button id="btnScanSpeak" type="button" class="min-h-[48px] px-4 rounded-xl bg-amber-600 dark:bg-amber-400 text-white dark:text-black font-extrabold text-sm flex items-center gap-2">
            🔊 Écouter
          </button>
          <button id="btnScanStop" type="button" class="min-h-[48px] px-4 rounded-xl border-2 border-zinc-300 dark:border-zinc-700 font-bold text-sm">
            ⏹️ Stop
          </button>
          <button id="btnScanSave" type="button" class="min-h-[48px] px-4 rounded-xl border-2 border-amber-600 dark:border-amber-400 text-amber-800 dark:text-amber-300 font-extrabold text-sm ml-auto">
            ⭐ Sauvegarder dans le Carnet
          </button>
        </div>
      </div>
    </section>

    <!-- ==================== ONGLET 3 : PROF (MODE SOCRATIQUE) ==================== -->
    <section id="tab-prof" class="tab-panel hidden space-y-4" aria-labelledby="heading-prof">
      <div class="rounded-3xl p-5 border-2 border-indigo-600/30 dark:border-indigo-400/40 bg-indigo-50/70 dark:bg-onyx-card">
        <div class="flex items-center justify-between gap-2 mb-2">
          <span class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-indigo-700 text-white dark:bg-indigo-400 dark:text-black">
            🦉 Mode Socratique
          </span>
          <button
            id="btnQuizExpress"
            type="button"
            class="min-h-[40px] px-3.5 rounded-xl bg-indigo-700 hover:bg-indigo-800 dark:bg-indigo-400 dark:hover:bg-indigo-300 text-white dark:text-black font-extrabold text-xs transition"
          >
            ⚡ Quiz Express (3 Q)
          </button>
        </div>
        <h2 id="heading-prof" class="text-2xl font-black tracking-tight mb-1">Je vous guide, vous trouvez !</h2>
        <p class="text-sm font-medium text-zinc-700 dark:text-zinc-300">
          Règle d'or : je ne donne <strong>jamais</strong> la réponse directe. Envoyez un exercice en photo ou posez votre question au micro, on avance étape par étape.
        </p>
      </div>

      <!-- Zone Quiz Express (masquée par défaut) -->
      <div id="quizContainer" class="hidden rounded-3xl p-5 border-2 border-indigo-500 bg-white dark:bg-onyx-card space-y-4 shadow-md">
        <div class="flex items-center justify-between">
          <h3 class="font-black text-lg text-indigo-700 dark:text-indigo-300">⚡ Quiz Express</h3>
          <button id="btnCloseQuiz" type="button" class="min-w-[44px] min-h-[44px] rounded-xl border-2 border-zinc-300 dark:border-zinc-700 font-bold">✕</button>
        </div>
        <div id="quizContent" class="space-y-3"></div>
      </div>

      <!-- Fil de discussion Socratique -->
      <div id="profChatLog" class="space-y-3 min-h-[220px] max-h-[46vh] overflow-y-auto pr-1">
        <!-- Message d'accueil injecté par JS -->
      </div>

      <!-- Aperçu photo d'exercice en attente -->
      <div id="profImagePending" class="hidden flex items-center gap-3 p-2.5 rounded-2xl bg-indigo-100 dark:bg-zinc-900 border-2 border-indigo-400">
        <img id="profImageThumb" alt="Exercice importé" class="w-14 h-14 rounded-xl object-cover" />
        <span class="text-xs font-bold flex-1">Photo d'exercice prête à être envoyée</span>
        <button id="btnClearProfImg" type="button" class="min-w-[40px] min-h-[40px] rounded-xl bg-zinc-200 dark:bg-zinc-800 font-bold">✕</button>
      </div>

      <!-- Zone de saisie Prof -->
      <div class="rounded-3xl p-3 border-2 border-zinc-300 dark:border-zinc-700 bg-white dark:bg-onyx-card space-y-2">
        <div class="flex items-center gap-2">
          <!-- Bouton photo exercice -->
          <label for="profFileInput" title="Photographier un exercice" class="cursor-pointer min-w-[48px] min-h-[48px] rounded-2xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 flex items-center justify-center text-xl">
            📷
            <input id="profFileInput" type="file" accept="image/*" capture="environment" class="sr-only" />
          </label>

          <!-- Bouton micro dictée -->
          <button id="btnProfMic" type="button" aria-label="Dicter ma question" class="min-w-[48px] min-h-[48px] rounded-2xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 flex items-center justify-center text-xl">
            🎙️
          </button>

          <!-- Champ texte -->
          <input
            id="profInput"
            type="text"
            placeholder="Posez votre question ou répondez..."
            class="flex-1 min-h-[48px] px-3 rounded-xl bg-transparent font-semibold text-sm sm:text-base focus:outline-none"
          />

          <!-- Envoyer -->
          <button id="btnProfSend" type="button" class="min-w-[52px] min-h-[48px] px-4 rounded-2xl bg-indigo-700 dark:bg-indigo-400 text-white dark:text-black font-extrabold text-sm">
            Envoyer
          </button>
        </div>

        <div class="flex items-center justify-between px-1">
          <button id="btnProfSaveNotion" type="button" class="text-xs font-extrabold text-indigo-700 dark:text-indigo-300 underline py-1">
            ⭐ Archiver cette séance dans le Carnet
          </button>
          <button id="btnProfReset" type="button" class="text-xs font-bold text-zinc-500 hover:text-rose-500 py-1">
            Nouvelle séance
          </button>
        </div>
      </div>
    </section>

    <!-- ==================== ONGLET 4 : CARNET (COLLECTION LOCALE) ==================== -->
    <section id="tab-carnet" class="tab-panel hidden space-y-5" aria-labelledby="heading-carnet">
      <div class="rounded-3xl p-5 border-2 border-rose-600/30 dark:border-rose-400/40 bg-rose-50/70 dark:bg-onyx-card space-y-4 no-print">
        <div class="flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-rose-700 text-white dark:bg-rose-400 dark:text-black">
