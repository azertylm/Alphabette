          }`;
        });
      }

      document.querySelectorAll('.level-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.scannerLevel = btn.dataset.level;
          updateLevelButtons();
          if (state.currentScan) {
            analyzeObject(true); // Ré-adapter le niveau si un objet est déjà affiché
          }
        });
      });

      document.getElementById('scannerFileInput').addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          state.scannerImageDataUrl = reader.result;
          const img = document.getElementById('scannerPreview');
          img.src = reader.result;
          img.classList.remove('hidden');
          document.getElementById('scannerPlaceholder').classList.add('hidden');
        };
        reader.readAsDataURL(file);
      });

      const DEMO_OBJECTS = {
        enfant: {
          name: 'Moulin à café mécanique Peugeot',
          origin: 'France, vers 1950 (l’époque de tes arrière-grands-parents !)',
          usage: 'On mettait des grains de café en haut, on tournait la manivelle avec la main, et la poudre magique tombait dans le petit tiroir en bois en bas.',
          story: "On raconte que ce moulin appartenait à un boulanger très pressé qui tournait la manivelle si vite qu'elle faisait le bruit d'un petit hélicoptère chaque matin à 5 heures !"
        },
        public: {
          name: 'Moulin à café manuel en bois et fonte (type Peugeot)',
          origin: 'France (Franche-Comté), années 1930-1950',
          usage: 'Broyage manuel des grains de café torréfiés grâce à une meule conique en acier réglable, recueillant la mouture dans un tiroir inférieur.',
          story: "Avant de finir sur une brocante, ce moulin a sans doute écouté des milliers de confidences matinales autour d'une toile cirée, rythmant le réveil d'une famille entière au son de sa manivelle."
        },
        expert: {
          name: 'Moulin à café domestique à meule hélicoïdale en acier cémenté',
          origin: 'Manufacture Peugeot Frères (Doubs), période entre-deux-guerres / Trente Glorieuses',
          usage: 'Mouture par cisaillement progressif permettant de préserver les composés aromatiques volatils du café sans échauffement thermique excessif.',
          story: "Rescapé de l'ère de l'obsolescence programmée, ce mécanisme de précision horlogère regarde probablement les machines à capsules modernes avec un léger mépris aristocratique."
        }
      };

      async function analyzeObject(isDemoForced = false) {
        if (!state.scannerImageDataUrl && !isDemoForced) {
          showToast('Prenez une photo ou cliquez sur « Tester un objet mystère ».');
          return;
        }

        const resBox = document.getElementById('scannerResult');
        resBox.classList.remove('hidden');
        document.getElementById('scanName').textContent = 'Analyse en cours...';

        const levelLabels = { enfant: 'Enfant 10 ans', public: 'Grand Public', expert: 'Expert' };
        document.getElementById('scanLevelBadge').textContent = `Niveau : ${levelLabels[state.scannerLevel]}`;

        let data = null;
        if (state.scannerImageDataUrl && state.settings.apiKey.trim()) {
          const aiResp = await callAI({
            systemPrompt: `Tu es un conservateur de musée doublé d'un conteur plein d'humour. Adapte ton vocabulaire au niveau : ${levelLabels[state.scannerLevel]}. Réponds en JSON strict avec les clés : 'name', 'origin', 'usage', 'story' (une petite histoire imaginaire et décalée de 2 phrases sur la vie secrète de cet objet).`,
            userPrompt: "Identifie cet objet sur la photo et remplis la fiche.",
            imageBase64: state.scannerImageDataUrl,
            expectJson: true,
          });
          if (aiResp) {
            try { data = JSON.parse(aiResp); } catch {}
          }
        }

        if (!data) {
          data = DEMO_OBJECTS[state.scannerLevel];
        }

        state.currentScan = {
          id: Date.now().toString(),
          type: 'objet',
          title: data.name,
          origin: data.origin,
          usage: data.usage,
          story: data.story,
          level: levelLabels[state.scannerLevel],
          image: state.scannerImageDataUrl,
          date: new Date().toLocaleDateString('fr-FR'),
        };

        document.getElementById('scanName').textContent = data.name;
        document.getElementById('scanOrigin').textContent = data.origin;
        document.getElementById('scanUsage').textContent = data.usage;
        document.getElementById('scanStory').textContent = data.story;
      }

      document.getElementById('btnAnalyzeObject').addEventListener('click', () => analyzeObject(false));
      document.getElementById('btnScannerDemoSample').addEventListener('click', () => analyzeObject(true));

      document.getElementById('btnScanSpeak').addEventListener('click', () => {
        if (!state.currentScan) return;
        const s = state.currentScan;
        speakText(`${s.title}. Époque et origine : ${s.origin}. Usage : ${s.usage}. Petite histoire imaginaire : ${s.story}`);
      });
      document.getElementById('btnScanStop').addEventListener('click', stopSpeaking);
      document.getElementById('btnScanSave').addEventListener('click', () => {
        if (!state.currentScan) return;
        state.carnet.unshift({ ...state.currentScan, id: Date.now().toString() });
        saveCarnet();
        showToast('⭐ Objet sauvegardé dans le Carnet !');
      });

      /* ============================================================
         7. MODULE 3 : PROF (MODE SOCRATIQUE + QUIZ EXPRESS)
         ============================================================ */
      const SOCRATIC_SYSTEM_PROMPT = `Tu es un professeur particulier bienveillant utilisant STRICTEMENT la méthode socratique.
RÈGLE ABSOLUE : Tu ne donnes JAMAIS la réponse finale à un exercice ou un problème.
- Félicite l'effort de l'élève.
- Décompose le problème en une toute petite étape.
- Pose UNE SEULE question guidée à la fois pour l'amener à trouver seul.
- Sois concis (3 à 4 phrases maximum), clair et encourageant.`;

      function addProfMessage(role, text, imgUrl = null) {
        state.profHistory.push({ role, text, imgUrl });
        const log = document.getElementById('profChatLog');
        const wrapper = document.createElement('div');
        wrapper.className = `flex flex-col ${role === 'user' ? 'items-end' : 'items-start'}`;

        const bubble = document.createElement('div');
        bubble.className = `max-w-[88%] rounded-2xl p-4 text-sm sm:text-base font-medium leading-relaxed shadow-sm ${
          role === 'user'
            ? 'bg-indigo-700 text-white dark:bg-indigo-400 dark:text-black font-semibold'
            : 'bg-white dark:bg-onyx-card border-2 border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-zinc-100'
        }`;

        if (imgUrl) {
          const img = document.createElement('img');
          img.src = imgUrl;
          img.alt = 'Exercice envoyé';
          img.className = 'max-h-40 rounded-xl mb-2 border border-white/20';
          bubble.appendChild(img);
        }

        const p = document.createElement('p');
        p.className = 'whitespace-pre-line';
        p.textContent = text;
        bubble.appendChild(p);

        if (role === 'assistant') {
          const actions = document.createElement('div');
          actions.className = 'flex items-center gap-2 mt-3 pt-2 border-t border-zinc-100 dark:border-zinc-800';
          const btnPlay = document.createElement('button');
          btnPlay.type = 'button';
          btnPlay.className = 'min-h-[38px] px-3 rounded-lg bg-indigo-100 dark:bg-indigo-500/20 text-indigo-900 dark:text-indigo-300 font-extrabold text-xs';
          btnPlay.textContent = '🔊 Écouter';
          btnPlay.onclick = () => speakText(text);

          const btnStop = document.createElement('button');
          btnStop.type = 'button';
          btnStop.className = 'min-h-[38px] px-3 rounded-lg border border-zinc-300 dark:border-zinc-700 font-bold text-xs';
          btnStop.textContent = '⏹️ Stop';
          btnStop.onclick = stopSpeaking;

          actions.append(btnPlay, btnStop);
          bubble.appendChild(actions);
        }

        wrapper.appendChild(bubble);
        log.appendChild(wrapper);
        log.scrollTop = log.scrollHeight;
      }

      function initProfChat() {
        state.profHistory = [];
        document.getElementById('profChatLog').innerHTML = '';
        addProfMessage(
          'assistant',
          "Bonjour ! Je suis ton Prof Socratique 🦉. Envoie-moi une photo d'exercice (maths, physique, histoire...) ou dicte ta question. Je ne te donnerai jamais la réponse toute faite, mais on va la trouver ensemble étape par étape !"
        );
      }

      document.getElementById('profFileInput').addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          state.profPendingImage = reader.result;
          document.getElementById('profImageThumb').src = reader.result;
          document.getElementById('profImagePending').classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      });

      document.getElementById('btnClearProfImg').addEventListener('click', () => {
        state.profPendingImage = null;
        document.getElementById('profImagePending').classList.add('hidden');
      });

      document.getElementById('btnProfMic').addEventListener('click', (e) => {
        startVoiceDictation(document.getElementById('profInput'), e.currentTarget);
      });

      async function handleProfSend() {
        const input = document.getElementById('profInput');
        const text = input.value.trim();
        const img = state.profPendingImage;
        if (!text && !img) return;

        addProfMessage('user', text || 'Voici la photo de mon exercice.', img);
        input.value = '';
        state.profPendingImage = null;
        document.getElementById('profImagePending').classList.add('hidden');

        const historyText = state.profHistory.slice(-6).map(m => `${m.role === 'user' ? 'Élève' : 'Prof'}: ${m.text}`).join('\n');
        const aiResp = await callAI({
          systemPrompt: SOCRATIC_SYSTEM_PROMPT,
          userPrompt: `Historique récent :\n${historyText}\n\nRéponds en tant que Prof Socratique.`,
          imageBase64: img,
        });

        let reply = aiResp;
        if (!reply) {
          // Réponses socratiques simulées intelligentes
          const step = state.profHistory.filter(m => m.role === 'user').length;
          if (step === 1) {
            reply = "Super point de départ ! Avant de calculer ou de répondre, quelles sont les données importantes que tu repères dans l'énoncé ? Dis-moi juste ce que l'on connaît déjà.";
          } else if (step === 2) {
            reply = "Très bien vu ! Maintenant que tu as isolé ces éléments, quelle règle ou quelle formule de ton cours relie ces informations entre elles ?";
          } else {
            reply = "Tu brûles ! Si tu appliques cette étape calmement, quel résultat intermédiaire obtiens-tu ? Vas-y, propose-moi ton calcul, on vérifie ensemble !";
          }
        }
        addProfMessage('assistant', reply);
      }

      document.getElementById('btnProfSend').addEventListener('click', handleProfSend);
      document.getElementById('profInput').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') handleProfSend();
      });
      document.getElementById('btnProfReset').addEventListener('click', initProfChat);

      document.getElementById('btnProfSaveNotion').addEventListener('click', () => {
        if (state.profHistory.length < 2) {
          showToast('Commencez une séance avant de l’archiver.');
          return;
        }
        const firstUserMsg = state.profHistory.find(m => m.role === 'user')?.text || 'Séance de révision';
        const summary = state.profHistory.slice(1).map(m => `${m.role === 'user' ? 'Moi' : 'Prof'} : ${m.text}`).join('\n\n');
        state.carnet.unshift({
          id: Date.now().toString(),
          type: 'prof',
          title: `Séance Prof : ${firstUserMsg.slice(0, 45)}${firstUserMsg.length > 45 ? '...' : ''}`,
          content: summary,
          date: new Date().toLocaleDateString('fr-FR'),
        });
        saveCarnet();
        showToast('⭐ Séance archivée dans le Carnet !');
      });

      // Quiz Express (3 questions interactives)
      const DEMO_QUIZ = [
        { q: "Dans un triangle rectangle, comment appelle-t-on le côté le plus long ?", options: ["L'hypoténuse", "La médiane", "La tangente"], answer: 0 },
        { q: "Quelle unité utilise-t-on pour mesurer une force en physique ?", options: ["Le Watt", "Le Newton", "Le Joule"], answer: 1 },
        { q: "Si on double la vitesse d'un objet, que devient son énergie cinétique ?", options: ["Elle double", "Elle est multipliée par 4", "Elle reste identique"], answer: 1 },
      ];

      document.getElementById('btnQuizExpress').addEventListener('click', async () => {
        const container = document.getElementById('quizContainer');
        const content = document.getElementById('quizContent');
        container.classList.remove('hidden');
        content.innerHTML = '<p class="text-sm font-bold">Génération de 3 questions rapides...</p>';

        let questions = DEMO_QUIZ;
        const lastTopic = state.profHistory.find(m => m.role === 'user')?.text || 'culture générale scientifique collège';
        const aiResp = await callAI({
          systemPrompt: "Génère un quiz de 3 questions courtes en français. Réponds en JSON strict : {\"questions\": [{\"q\": \"...\", \"options\": [\"A\", \"B\", \"C\"], \"answer\": 0}]} où answer est l'index (0, 1 ou 2) de la bonne réponse.",
          userPrompt: `Thème du quiz : ${lastTopic}`,
          expectJson: true,
        });
        if (aiResp) {
          try {
            const parsed = JSON.parse(aiResp);
            if (Array.isArray(parsed.questions) && parsed.questions.length === 3) questions = parsed.questions;
          } catch {}
        }

        content.innerHTML = '';
        questions.forEach((item, idx) => {
          const card = document.createElement('div');
          card.className = 'p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-2.5';

          const header = document.createElement('div');
          header.className = 'flex items-start justify-between gap-2';
          const qText = document.createElement('p');
          qText.className = 'font-extrabold text-sm';
          qText.textContent = `${idx + 1}. ${item.q}`;
          const btnAudio = document.createElement('button');
          btnAudio.type = 'button';
          btnAudio.className = 'min-w-[40px] min-h-[40px] rounded-xl bg-indigo-100 dark:bg-indigo-500/20 text-indigo-800 dark:text-indigo-300 font-bold text-sm';
          btnAudio.textContent = '🔊';
          btnAudio.onclick = () => speakText(`Question ${idx + 1}. ${item.q}`);
          header.append(qText, btnAudio);

          const opts = document.createElement('div');
          opts.className = 'grid grid-cols-1 gap-2';
          item.options.forEach((opt, optIdx) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'min-h-[44px] text-left px-3.5 py-2 rounded-xl border-2 border-zinc-300 dark:border-zinc-700 font-bold text-sm transition';
            btn.textContent = opt;
            btn.onclick = () => {
              if (optIdx === item.answer) {
                btn.className = 'min-h-[44px] text-left px-3.5 py-2 rounded-xl border-2 border-emerald-600 bg-emerald-100 dark:bg-emerald-500/20 text-emerald-900 dark:text-emerald-300 font-extrabold text-sm';
                showToast('✅ Bravo, bonne réponse !');
              } else {
                btn.className = 'min-h-[44px] text-left px-3.5 py-2 rounded-xl border-2 border-rose-600 bg-rose-100 dark:bg-rose-500/20 text-rose-900 dark:text-rose-300 font-extrabold text-sm';
                showToast('❌ Pas tout à fait, réessaie !');
              }
            };
            opts.appendChild(btn);
          });

          card.append(header, opts);
          content.appendChild(card);
        });
      });

      document.getElementById('btnCloseQuiz').addEventListener('click', () => {
        document.getElementById('quizContainer').classList.add('hidden');
      });

      /* ============================================================
         8. MODULE 4 : CARNET (COLLECTION LOCALE & EXPORT)
         ============================================================ */
      function updateFilterButtons() {
        document.querySelectorAll('.filter-btn').forEach(btn => {
          const active = btn.dataset.filter === state.carnetFilter;
          btn.className = `filter-btn min-h-[44px] px-4 rounded-xl font-extrabold text-sm whitespace-nowrap border-2 transition ${
            active
              ? 'bg-rose-700 dark:bg-rose-400 text-white dark:text-black border-rose-700 dark:border-rose-400'
              : 'bg-white dark:bg-onyx-card text-zinc-800 dark:text-zinc-200 border-zinc-300 dark:border-zinc-700'
          }`;
        });
      }

      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.carnetFilter = btn.dataset.filter;
          updateFilterButtons();
          renderCarnet();
        });
      });

      function renderCarnet() {
        const list = document.getElementById('carnetList');
        const filtered = state.carnetFilter === 'all'
          ? state.carnet
          : state.carnet.filter(item => item.type === state.carnetFilter);

        document.getElementById('carnetCount').textContent = `${state.carnet.length} entrée${state.carnet.length > 1 ? 's' : ''}`;

        if (filtered.length === 0) {
          list.innerHTML = `
            <div class="rounded-3xl p-8 text-center border-2 border-dashed border-zinc-300 dark:border-zinc-700 space-y-2">
              <div class="text-4xl">📓</div>
              <p class="font-extrabold text-base">Aucune découverte enregistrée ici</p>
              <p class="text-sm text-zinc-600 dark:text-zinc-400">Explorez une Balade, scannez un Objet ou archivez une séance Prof pour remplir votre Carnet.</p>
            </div>`;
          return;
        }

        const BADGE_META = {
          balade: { label: '🧭 Balade', cls: 'bg-emerald-100 text-emerald-900 dark:bg-emerald-500/20 dark:text-emerald-300' },
          objet: { label: '🔎 Objet', cls: 'bg-amber-100 text-amber-900 dark:bg-amber-500/20 dark:text-amber-300' },
          prof: { label: '🦉 Prof', cls: 'bg-indigo-100 text-indigo-900 dark:bg-indigo-500/20 dark:text-indigo-300' },
        };

        list.innerHTML = '';
        filtered.forEach(item => {
          const meta = BADGE_META[item.type] || BADGE_META.balade;
          const card = document.createElement('article');
          card.className = 'print-card rounded-3xl p-5 border-2 border-zinc-200 dark:border-onyx-border bg-white dark:bg-onyx-card shadow-sm space-y-3';

          const bodyText = item.type === 'objet'
            ? `Époque : ${item.origin}\nUsage : ${item.usage}\nHistoire : ${item.story}`
            : item.content;

          card.innerHTML = `
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-extrabold uppercase px-2.5 py-1 rounded-full ${meta.cls}">${meta.label}</span>
              <span class="text-xs font-bold text-zinc-500">${item.date || ''}</span>
            </div>
            <h3 class="text-lg font-black">${item.title}</h3>
            ${item.image ? `<img src="${item.image}" alt="${item.title}" class="max-h-48 rounded-2xl object-cover border border-zinc-200 dark:border-zinc-800" />` : ''}
            <p class="text-sm font-medium leading-relaxed text-zinc-800 dark:text-zinc-200 whitespace-pre-line"></p>
            <div class="flex items-center gap-2 pt-2 border-t border-zinc-100 dark:border-zinc-800 no-print">
              <button type="button" class="carnet-speak min-h-[42px] px-3.5 rounded-xl bg-zinc-900 dark:bg-zinc-100 text-white dark:text-black font-extrabold text-xs">🔊 Écouter</button>
              <button type="button" class="carnet-stop min-h-[42px] px-3 rounded-xl border-2 border-zinc-300 dark:border-zinc-700 font-bold text-xs">⏹️ Stop</button>
              <button type="button" class="carnet-del min-h-[42px] px-3 rounded-xl text-rose-600 dark:text-rose-400 font-extrabold text-xs ml-auto">🗑️ Supprimer</button>
            </div>
          `;
          card.querySelector('p').textContent = bodyText;
          card.querySelector('.carnet-speak').onclick = () => speakText(`${item.title}. ${bodyText}`);
          card.querySelector('.carnet-stop').onclick = stopSpeaking;
          card.querySelector('.carnet-del').onclick = () => {
            state.carnet = state.carnet.filter(c => c.id !== item.id);
            saveCarnet();
            showToast('Entrée supprimée du Carnet.');
          };

          list.appendChild(card);
        });
      }

      // Export JSON
      document.getElementById('btnExportJSON').addEventListener('click', () => {
        if (state.carnet.length === 0) {
          showToast('Votre Carnet est vide.');
          return;
        }
        const blob = new Blob([JSON.stringify(state.carnet, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `curioz-carnet-${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast('💾 Carnet exporté en JSON !');
      });

      // Version imprimable
      document.getElementById('btnExportPrint').addEventListener('click', () => {
        window.print();
      });

      /* ============================================================
         9. MODAL PARAMÈTRES & INITIALISATION
         ============================================================ */
      const modalSettings = document.getElementById('modalSettings');
      document.getElementById('btnOpenSettings').addEventListener('click', () => {
        document.getElementById('selectProvider').value = state.settings.provider;
        document.getElementById('inputApiKey').value = state.settings.apiKey;
        document.getElementById('rangeTtsSpeed').value = state.settings.ttsSpeed;
        document.getElementById('ttsSpeedLabel').textContent = `${Number(state.settings.ttsSpeed).toFixed(2)}x`;
        modalSettings.classList.remove('hidden');
      });

      document.getElementById('btnCloseSettings').addEventListener('click', () => modalSettings.classList.add('hidden'));
      document.getElementById('rangeTtsSpeed').addEventListener('input', (e) => {
        document.getElementById('ttsSpeedLabel').textContent = `${Number(e.target.value).toFixed(2)}x`;
      });

      document.getElementById('btnSaveSettings').addEventListener('click', () => {
        state.settings.provider = document.getElementById('selectProvider').value;
        state.settings.apiKey = document.getElementById('inputApiKey').value.trim();
        state.settings.ttsSpeed = parseFloat(document.getElementById('rangeTtsSpeed').value) || 1.0;
        saveSettings();
        modalSettings.classList.add('hidden');
        showToast('✅ Paramètres enregistrés !');
      });

      document.getElementById('btnThemeToggle').addEventListener('click', () => {
        state.settings.theme = state.settings.theme === 'dark' ? 'light' : 'dark';
        applyTheme();
        saveSettings();
      });

      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.addEventListener('click', () => switchTab(btn.dataset.tab));
      });

      // Lancement initial
      loadState();
      applyTheme();
