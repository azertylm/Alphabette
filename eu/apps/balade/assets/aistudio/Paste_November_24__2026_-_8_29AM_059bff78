      /* ============================================================
         6. MODULE 2 : SCANNER (DÉTECTIVE D'OBJET)
         ============================================================ */
      function updateLevelButtons() {
        document.querySelectorAll('.level-btn').forEach(btn => {
          const active = btn.dataset.level === state.scannerLevel;
          btn.className = `level-btn min-h-[48px] rounded-xl font-extrabold text-xs sm:text-sm border-2 transition px-2 ${
            active
              ? 'bg-amber-600 dark:bg-amber-400 text-white dark:text-black border-amber-700 dark:border-amber-300 shadow-sm'
