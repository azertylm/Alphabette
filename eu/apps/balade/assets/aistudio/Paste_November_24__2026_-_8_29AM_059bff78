  <div id="toast" class="hidden fixed top-20 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-2xl bg-zinc-900 dark:bg-white text-white dark:text-black font-extrabold text-sm shadow-xl border-2 border-zinc-700 dark:border-zinc-300 text-center max-w-[90vw]"></div>

  <!-- ==================== JAVASCRIPT MODULAIRE ==================== -->
  <script>
    (() => {
      'use strict';

      /* ============================================================
         1. ÉTAT GLOBAL & STOCKAGE LOCAL (LOCAL-FIRST / ZERO-KNOWLEDGE)
         ============================================================ */
      const STORAGE_KEYS = {
        SETTINGS: 'curioz_settings_v1',
        CARNET: 'curioz_carnet_v1',
      };

      const state = {
        activeTab: 'balade',
        settings: {
          theme: 'dark', // 'dark' (Onyx) | 'light' (Clarté)
          provider: 'gemini',
          apiKey: '',
          ttsSpeed: 1.0,
        },
        carnet: [],
        carnetFilter: 'all',
        currentBalade: null,
        scannerLevel: 'public', // 'enfant' | 'public' | 'expert'
        scannerImageDataUrl: null,
        currentScan: null,
        profHistory: [],
        profPendingImage: null,
        isRecording: false,
      };

      function loadState() {
        try {
          const savedSettings = JSON.parse(localStorage.getItem(STORAGE_KEYS.SETTINGS));
          if (savedSettings) state.settings = { ...state.settings, ...savedSettings };
          const savedCarnet = JSON.parse(localStorage.getItem(STORAGE_KEYS.CARNET));
          if (Array.isArray(savedCarnet)) state.carnet = savedCarnet;
        } catch (e) {
          console.warn('Erreur lecture localStorage:', e);
        }
      }

      function saveSettings() {
        localStorage.setItem(STORAGE_KEYS.SETTINGS, JSON.stringify(state.settings));
        updateModeBadge();
      }

      function saveCarnet() {
        localStorage.setItem(STORAGE_KEYS.CARNET, JSON.stringify(state.carnet));
        renderCarnet();
      }

      /* ============================================================
         2. UTILITAIRES UI (TOAST, THÈME, ONGLETS)
         ============================================================ */
      let toastTimer = null;
      function showToast(msg) {
        const el = document.getElementById('toast');
        el.textContent = msg;
        el.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => el.classList.add('hidden'), 3200);
      }

      function applyTheme() {
        const isDark = state.settings.theme === 'dark';
        document.documentElement.classList.toggle('dark', isDark);
        document.querySelector('meta[name="theme-color"]').setAttribute('content', isDark ? '#09090B' : '#FFFFFF');
        document.getElementById('themeIcon').textContent = isDark ? '☀️' : '🌙';
        document.getElementById('themeLabel').textContent = isDark ? 'Clarté' : 'Onyx';
      }

      function updateModeBadge() {
        const badge = document.getElementById('modeBadge');
        if (state.settings.apiKey.trim()) {
          badge.textContent = state.settings.provider === 'mistral' ? 'Mistral' : 'Gemini';
        } else {
          badge.textContent = 'Démo';
        }
      }

      const TAB_COLORS = {
        balade: { badge: 'bg-emerald-600 dark:bg-emerald-500', activeNav: 'bg-emerald-100 text-emerald-900 dark:bg-emerald-500/20 dark:text-emerald-300' },
        scanner: { badge: 'bg-amber-600 dark:bg-amber-500', activeNav: 'bg-amber-100 text-amber-900 dark:bg-amber-500/20 dark:text-amber-300' },
        prof: { badge: 'bg-indigo-600 dark:bg-indigo-500', activeNav: 'bg-indigo-100 text-indigo-900 dark:bg-indigo-500/20 dark:text-indigo-300' },
        carnet: { badge: 'bg-rose-600 dark:bg-rose-500', activeNav: 'bg-rose-100 text-rose-900 dark:bg-rose-500/20 dark:text-rose-300' },
      };

      function switchTab(tabName) {
        state.activeTab = tabName;
        stopSpeaking();

        document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
        document.getElementById(`tab-${tabName}`).classList.remove('hidden');

        // Mise à jour couleur logo
        const brandBadge = document.getElementById('brandBadge');
        brandBadge.className = `w-11 h-11 rounded-2xl ${TAB_COLORS[tabName].badge} flex items-center justify-center text-white font-black text-xl shadow-md transition-colors`;

        // Mise à jour Bottom Nav
        document.querySelectorAll('.nav-btn').forEach(btn => {
          const isCurrent = btn.dataset.tab === tabName;
          btn.className = `nav-btn min-h-[56px] rounded-2xl flex flex-col items-center justify-center gap-0.5 font-extrabold text-xs transition ${
            isCurrent ? TAB_COLORS[tabName].activeNav : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-900'
          }`;
          btn.setAttribute('aria-current', isCurrent ? 'page' : 'false');
        });

        if (tabName === 'carnet') renderCarnet();
      }

      /* ============================================================
         3. SYNTHÈSE VOCALE (TTS) & DICTÉE VOCALE (STT)
         ============================================================ */
      function speakText(text) {
        if (!('speechSynthesis' in window)) {
          showToast('Synthèse vocale non supportée sur ce navigateur.');
          return;
        }
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'fr-FR';
        utterance.rate = parseFloat(state.settings.ttsSpeed) || 1.0;
        window.speechSynthesis.speak(utterance);
      }

      function stopSpeaking() {
        if ('speechSynthesis' in window) {
          window.speechSynthesis.cancel();
        }
      }

      function startVoiceDictation(targetInput, buttonEl) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) {
          showToast('Dictée vocale non disponible sur ce navigateur.');
          return;
        }
        const recognition = new SpeechRecognition();
        recognition.lang = 'fr-FR';
        recognition.interimResults = false;
        recognition.maxAlternatives = 1;

        buttonEl.classList.add('recording-pulse', 'bg-rose-600', 'text-white');
        showToast('🎙️ Je vous écoute...');

        recognition.onresult = (event) => {
          const transcript = event.results[0][0].transcript;
          targetInput.value = targetInput.value ? `${targetInput.value} ${transcript}` : transcript;
        };
        recognition.onerror = () => {
          showToast('Impossible de capter la voix. Vérifiez le micro.');
        };
        recognition.onend = () => {
          buttonEl.classList.remove('recording-pulse', 'bg-rose-600', 'text-white');
        };
        recognition.start();
      }

      /* ============================================================
         4. CLIENT API IA UNIFIÉ (GEMINI / MISTRAL) + MODE DÉMO
         ============================================================ */
      async function callAI({ systemPrompt, userPrompt, imageBase64 = null, expectJson = false }) {
        const apiKey = state.settings.apiKey.trim();
        if (!apiKey) return null; // Déclenche le mode démo

        try {
          if (state.settings.provider === 'gemini') {
            const parts = [{ text: userPrompt }];
            if (imageBase64) {
              const mime = imageBase64.match(/^data:(.*?);base64,/)?.[1] || 'image/jpeg';
              const data = imageBase64.split(',')[1];
              parts.push({ inlineData: { mimeType: mime, data } });
            }
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${encodeURIComponent(apiKey)}`;
            const body = {
              systemInstruction: { parts: [{ text: systemPrompt }] },
              contents: [{ role: 'user', parts }],
            };
            if (expectJson) {
              body.generationConfig = { responseMimeType: 'application/json' };
            }
            const res = await fetch(url, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (!res.ok) throw new Error('Erreur Gemini API');
            const json = await res.json();
            return json.candidates?.[0]?.content?.parts?.[0]?.text || null;
          } else {
            // Mistral AI
            const messages = [{ role: 'system', content: systemPrompt }];
            if (imageBase64) {
              messages.push({
                role: 'user',
                content: [
                  { type: 'text', text: userPrompt },
                  { type: 'image_url', image_url: imageBase64 }
                ]
              });
            } else {
              messages.push({ role: 'user', content: userPrompt });
            }
            const res = await fetch('https://api.mistral.ai/v1/chat/completions', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${apiKey}`,
              },
              body: JSON.stringify({
                model: imageBase64 ? 'pixtral-12b-2409' : 'mistral-small-latest',
                messages,
                response_format: expectJson ? { type: 'json_object' } : undefined,
              }),
            });
            if (!res.ok) throw new Error('Erreur Mistral API');
            const json = await res.json();
            return json.choices?.[0]?.message?.content || null;
          }
        } catch (err) {
          console.error(err);
          showToast('Erreur API : bascule automatique en mode Démo.');
          return null;
        }
      }

      /* ============================================================
         5. MODULE 1 : BALADE (L'OREILLE LOCALE)
         ============================================================ */
      const DEMO_BALADES = {
        'la grande-motte': {
          title: 'Les Pyramides inspirées des temples précolombiens',
          text: "Saviez-vous que l'architecture de La Grande-Motte n'a rien d'un hasard ? Dans les années 1960, l'architecte Jean Balladur a voyagé au Mexique et a été fasciné par les pyramides de Teotihuacan.\n\nEn observant les façades autour de vous, remarquez les lignes courbes côté Couchant (symbole féminin) et les angles plus droits côté Levant (symbole masculin). Même les bancs, les lampadaires et les jardinières ont été dessinés sur mesure pour que la ville ressemble à une sculpture géante face à la Méditerranée."
        },
        'lille': {
          title: 'Wazemmes et le secret des anciens moulins',
          text: "Avant de devenir le quartier bouillonnant et cosmopolite que l'on connaît aujourd'hui, Wazemmes était un village indépendant rempli de moulins à vent et de guinguettes où les Lillois venaient faire la fête le dimanche pour éviter les taxes de la ville.\n\nSous vos pieds passaient autrefois des bras de la Deûle utilisés par les blanchisseurs. C'est cette énergie populaire et musicale qui survit encore chaque dimanche matin autour des Halles de Wazemmes."
        },
        'montmartre': {
          title: 'Le passe-muraille et la vigne cachée',
          text: "À deux pas des ruelles touristiques de Montmartre se cache le Clos Montmartre, l'un des derniers vignobles actifs de Paris, planté en 1933 pour empêcher un projet immobilier.\n\nSi vous levez les yeux vers la place Marcel-Aymé, vous croiserez la statue en bronze du Passe-Muraille, sculptée par Jean Marais : n'oubliez pas de lui serrer la main gauche, la légende dit qu'elle porte chance aux rêveurs."
        }
      };

      async function generateBalade(locationName) {
        const cleanLoc = locationName.trim();
        if (!cleanLoc) {
          showToast('Indiquez une ville ou un quartier.');
          return;
        }

        const resultBox = document.getElementById('baladeResult');
        const titleEl = document.getElementById('baladeTitle');
        const textEl = document.getElementById('baladeText');
        const tagEl = document.getElementById('baladeLocTag');

        resultBox.classList.remove('hidden');
        tagEl.textContent = `📍 ${cleanLoc}`;
        titleEl.textContent = 'Recherche d’anecdotes locales...';
        textEl.textContent = 'Préparation de votre capsule audio...';

        const aiResp = await callAI({
          systemPrompt: "Tu es un guide culturel passionné, chaleureux et concis. Réponds en JSON strict avec les clés 'title' (titre accrocheur) et 'text' (capsule audio de 100 à 140 mots, fluide à écouter à voix haute, sur une anecdote insolite, une légende ou un détail d'architecture du lieu).",
          userPrompt: `Raconte-moi une capsule audio passionnante sur ce lieu : ${cleanLoc}.`,
          expectJson: true,
        });

        let data = null;
        if (aiResp) {
          try { data = JSON.parse(aiResp); } catch {}
        }

        if (!data) {
          const lower = cleanLoc.toLowerCase();
          if (lower.includes('grande-motte')) data = DEMO_BALADES['la grande-motte'];
          else if (lower.includes('lille') || lower.includes('wazemmes')) data = DEMO_BALADES['lille'];
          else if (lower.includes('montmartre') || lower.includes('paris')) data = DEMO_BALADES['montmartre'];
          else {
            data = {
              title: `Trésors cachés de ${cleanLoc}`,
              text: `Bienvenue à ${cleanLoc} ! Prenez quelques secondes pour lever les yeux au-dessus des vitrines : c'est souvent au premier étage que se cache la véritable mémoire d'un quartier.\n\nObservez les ferronneries des balcons, les anciennes plaques de rue ou la couleur des pierres : elles racontent l'époque où les artisans locaux façonnaient chaque bâtiment à la main. (Ajoutez une clé API Gemini ou Mistral dans ⚙️ pour des anecdotes ultra-précises sur chaque rue !)`
            };
          }
        }

        state.currentBalade = {
          id: Date.now().toString(),
          type: 'balade',
          location: cleanLoc,
          title: data.title,
          content: data.text,
          date: new Date().toLocaleDateString('fr-FR'),
        };

        titleEl.textContent = data.title;
        textEl.textContent = data.text;
        speakText(`${data.title}. ${data.text}`);
      }

      document.getElementById('btnGeolocate').addEventListener('click', () => {
        if (!('geolocation' in navigator)) {
          showToast('Géolocalisation non supportée. Saisissez votre ville.');
          return;
        }
        showToast('📡 Localisation en cours...');
        navigator.geolocation.getCurrentPosition(
          async (pos) => {
            const { latitude, longitude } = pos.coords;
            try {
              const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}&accept-language=fr`);
              const data = await res.json();
              const city = data.address?.city || data.address?.town || data.address?.village || data.address?.suburb || `${latitude.toFixed(2)}, ${longitude.toFixed(2)}`;
              document.getElementById('inputLocation').value = city;
              generateBalade(city);
            } catch {
              generateBalade('La Grande-Motte');
            }
          },
          () => {
            showToast('Position refusée. Vous pouvez saisir votre ville manuellement.');
          },
          { timeout: 8000 }
        );
      });

      document.getElementById('btnSearchLocation').addEventListener('click', () => {
        generateBalade(document.getElementById('inputLocation').value);
      });

      document.querySelectorAll('.quick-loc').forEach(btn => {
        btn.addEventListener('click', () => {
          document.getElementById('inputLocation').value = btn.dataset.quickLoc;
          generateBalade(btn.dataset.quickLoc);
        });
      });

      document.getElementById('btnBaladeSpeak').addEventListener('click', () => {
        if (state.currentBalade) speakText(`${state.currentBalade.title}. ${state.currentBalade.content}`);
      });
      document.getElementById('btnBaladeStop').addEventListener('click', stopSpeaking);
      document.getElementById('btnBaladeSave').addEventListener('click', () => {
        if (!state.currentBalade) return;
        state.carnet.unshift({ ...state.currentBalade, id: Date.now().toString() });
        saveCarnet();
