      function buildDemoVerdict(subject, activePlayers, judgeKey) {
        const culpritObj = activePlayers[Math.floor(Math.random() * activePlayers.length)];
        const innocentObj = activePlayers.find(p => p !== culpritObj) || activePlayers[0];
        const pleaSnippet = culpritObj.plea
          ? `notamment l'argument hautement suspect « ${culpritObj.plea.slice(0, 75)}${culpritObj.plea.length > 75 ? '...' : ''} »`
          : `un silence assourdissant qui confine à l'aveu complet`;

        const forfeits = [
          `Préparer le prochain café ou thé de ${innocentObj.name} en l'appelant « Votre Honneur » pendant 24 heures.`,
          `Faire un discours solennel de 30 secondes sur la grandeur morale de ${innocentObj.name}, debout sur une jambe.`,
          `Céder officiellement le contrôle absolu de la télécommande et de la playlist jusqu'à demain midi.`,
          `Rédiger une lettre d'excuses diplomatiques au sujet de « ${subject} » et la lire avec un accent dramatique.`,
          `Offrir la prochaine fournée de viennoiseries en prononçant le mot que ${innocentObj.name} préfère.`,
        ];
        const forfeit = forfeits[Math.floor(Math.random() * forfeits.length)];

        let reasoning = '';
        if (judgeKey === 'solennel') {
          reasoning = `VU le Code Civil des Petits Riens, article 42 alinéa B ;\nATTENDU que le litige portant sur « ${subject} » trouble gravement l'ordre domestique ;\nATTENDU que la défense de ${culpritObj.name} — ${pleaSnippet} — manque cruellement de rigueur juridique face à la droiture exemplaire de ${innocentObj.name} ;\nPAR CES MOTIFS, la Cour statue en dernier ressort et condamne la mauvaise foi caractérisée.`;
        } else if (judgeKey === 'satiriste') {
          reasoning = `Franchement, on a rarement vu un dossier aussi bancal sur « ${subject} ». Pendant que ${innocentObj.name} tente péniblement de sauver l'honneur de l'humanité, ${culpritObj.name} nous sert ${pleaSnippet}. C'est audacieux, c'est théâtral, mais ça ne trompe absolument personne. Le tribunal salue l'effort artistique mais sanctionne l'escroquerie intellectuelle.`;
        } else {
          reasoning = `OH LA LA MESDAMES ET MESSIEURS ! QUEL MATCH DE FOLIE SUR « ${subject} » !! On fait appel à la VAR... ET C'EST CARTON ROUGE DIRECT POUR ${culpritObj.name.toUpperCase()} ! Regardez ce ralenti : ${pleaSnippet} ! Face au pressing chirurgical de ${innocentObj.name}, c'est un K.O. technique à la 90e minute ! LE STADE EST EN DÉLIRE !`;
        }

        return {
          culprit: culpritObj.name,
          reasoning,
          forfeit,
        };
      }

