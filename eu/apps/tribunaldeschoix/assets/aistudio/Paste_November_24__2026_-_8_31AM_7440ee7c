  <!-- ==================== JAVASCRIPT MODULAIRE ==================== -->
  <script>
    (() => {
      'use strict';

      /* ============================================================
         1. ÉTAT GLOBAL & STOCKAGE LOCAL (LOCAL-FIRST)
         ============================================================ */
      const STORAGE = {
        SETTINGS: 'lebazar_settings_v1',
        GALLERY: 'lebazar_gallery_v1',
      };

      const state = {
        activeTab: 'tribunal',
        settings: {
          theme: 'light', // 'light' (Clarté) | 'dark' (Onyx)
          provider: 'demo', // 'demo' | 'gemini' | 'mistral'
          apiKey: '',
          ttsSpeed: 1.05,
        },
        // Tribunal
        playerCount: 2,
        players: [
          { name: 'Camille', plea: '' },
          { name: 'Julien', plea: '' },
          { name: 'Sam', plea: '' },
        ],
        judge: 'solennel', // 'solennel' | 'satiriste' | 'sportif'
        activeTimer: null,
        activeRecognition: null,
        recordingPlayerIdx: null,
        currentVerdict: null,
        // La Une
        unePhotoDataUrl: null,
        currentUne: null,
        // Défi Local
        currentChallengeIdx: 0,
        defiPhotoDataUrl: null,
        gallery: [],
      };

      function loadState() {
        try {
          const s = JSON.parse(localStorage.getItem(STORAGE.SETTINGS));
          if (s) state.settings = { ...state.settings, ...s };
          const g = JSON.parse(localStorage.getItem(STORAGE.GALLERY));
          if (Array.isArray(g) && g.length > 0) {
            state.gallery = g;
          } else {
            state.gallery = createInitialDemoGallery();
            localStorage.setItem(STORAGE.GALLERY, JSON.stringify(state.gallery));
          }
        } catch (err) {
          console.warn('Lecture localStorage:', err);
          state.gallery = createInitialDemoGallery();
        }
      }

      function saveSettings() {
        try {
          localStorage.setItem(STORAGE.SETTINGS, JSON.stringify(state.settings));
        } catch (e) { console.warn(e); }
        updateModeBadge();
      }

      function saveGallery() {
        try {
          localStorage.setItem(STORAGE.GALLERY, JSON.stringify(state.gallery));
        } catch (e) {
          showToast('Mémoire locale pleine : supprimez une ancienne photo.');
        }
        renderGallery();
      }

      /* ============================================================
         2. MOTEUR AUDIO SYNTHÉTIQUE (WEB AUDIO API — ZÉRO FICHIER)
         ============================================================ */
      const SoundEngine = (() => {
        let ctx = null;
        function getCtx() {
          if (!ctx) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) ctx = new AudioCtx();
          }
          if (ctx && ctx.state === 'suspended') ctx.resume();
          return ctx;
        }

        // 1. Coup de marteau de juge (double frappe boisée réaliste)
        function playGavel() {
          const c = getCtx();
          if (!c) return;
          const now = c.currentTime;
          [0, 0.23].forEach((offset, i) => {
            const t = now + offset;
            // Corps boisé (oscillateur triangle à pitch décroissant)
            const osc = c.createOscillator();
            const gain = c.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(i === 0 ? 210 : 195, t);
            osc.frequency.exponentialRampToValueAtTime(68, t + 0.11);
            gain.gain.setValueAtTime(0.75, t);
            gain.gain.exponentialRampToValueAtTime(0.001, t + 0.14);
            osc.connect(gain);
            gain.connect(c.destination);
            osc.start(t);
            osc.stop(t + 0.15);

            // Claquement sec (bruit blanc filtré passe-bande)
            const bufSize = Math.floor(c.sampleRate * 0.05);
            const buf = c.createBuffer(1, bufSize, c.sampleRate);
            const data = buf.getChannelData(0);
            for (let j = 0; j < bufSize; j++) data[j] = (Math.random() * 2 - 1) * Math.exp(-j / (bufSize * 0.25));
            const noise = c.createBufferSource();
            noise.buffer = buf;
            const filter = c.createBiquadFilter();
            filter.type = 'bandpass';
            filter.frequency.setValueAtTime(950, t);
            filter.Q.setValueAtTime(2.5, t);
            const nGain = c.createGain();
            nGain.gain.setValueAtTime(0.6, t);
            nGain.gain.exponentialRampToValueAtTime(0.001, t + 0.05);
            noise.connect(filter);
            filter.connect(nGain);
            nGain.connect(c.destination);
            noise.start(t);
          });
        }

        // 2. Jingle Journal Télévisé (Flash Info dramatique)
        function playNewsJingle() {
          const c = getCtx();
          if (!c) return;
          const now = c.currentTime;
          // Arpège rapide + accord final brillant
          const notes = [
            { f: 523.25, t: 0.0, d: 0.14 },  // C5
            { f: 659.25, t: 0.12, d: 0.14 }, // E5
            { f: 783.99, t: 0.24, d: 0.14 }, // G5
            { f: 1046.5, t: 0.38, d: 0.75 }, // C6
            { f: 523.25, t: 0.38, d: 0.75 }, // C5 accord
            { f: 783.99, t: 0.38, d: 0.75 }, // G5 accord
            { f: 130.81, t: 0.38, d: 0.85 }, // C3 basse
          ];
          notes.forEach(n => {
            const osc = c.createOscillator();
            const filter = c.createBiquadFilter();
            const gain = c.createGain();
            osc.type = n.f < 200 ? 'triangle' : 'sawtooth';
            osc.frequency.setValueAtTime(n.f, now + n.t);
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(2400, now + n.t);
            filter.frequency.exponentialRampToValueAtTime(900, now + n.t + n.d);
            gain.gain.setValueAtTime(0.001, now + n.t);
            gain.gain.linearRampToValueAtTime(n.f < 200 ? 0.35 : 0.14, now + n.t + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, now + n.t + n.d);
            osc.connect(filter);
            filter.connect(gain);
            gain.connect(c.destination);
            osc.start(now + n.t);
            osc.stop(now + n.t + n.d + 0.02);
          });
        }

        // 3. Déclencheur appareil photo (double clic mécanique)
        function playShutter() {
          const c = getCtx();
          if (!c) return;
          const now = c.currentTime;
          [0, 0.065].forEach((offset, idx) => {
            const t = now + offset;
            const bufSize = Math.floor(c.sampleRate * 0.03);
            const buf = c.createBuffer(1, bufSize, c.sampleRate);
            const data = buf.getChannelData(0);
            for (let i = 0; i < bufSize; i++) data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufSize * 0.18));
            const src = c.createBufferSource();
            src.buffer = buf;
            const hp = c.createBiquadFilter();
            hp.type = 'highpass';
            hp.frequency.setValueAtTime(idx === 0 ? 1800 : 2600, t);
            const g = c.createGain();
            g.gain.setValueAtTime(0.45, t);
            g.gain.exponentialRampToValueAtTime(0.001, t + 0.03);
            src.connect(hp);
            hp.connect(g);
            g.connect(c.destination);
            src.start(t);
          });
        }

        return { playGavel, playNewsJingle, playShutter };
      })();

      /* ============================================================
         3. UTILITAIRES UI, TTS, STT & REDIMENSIONNEMENT IMAGE
         ============================================================ */
      let toastTimer = null;
      function showToast(msg) {
        const el = document.getElementById('toast');
        el.textContent = msg;
        el.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => el.classList.add('hidden'), 3200);
      }

      function speakText(text) {
        if (!('speechSynthesis' in window)) {
          showToast('Synthèse vocale non supportée sur ce navigateur.');
          return;
        }
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(text);
        u.lang = 'fr-FR';
        u.rate = parseFloat(state.settings.ttsSpeed) || 1.05;
        window.speechSynthesis.speak(u);
      }

      function stopSpeaking() {
        if ('speechSynthesis' in window) window.speechSynthesis.cancel();
      }

      // Compression & redimensionnement propre des photos smartphones pour localStorage & Canvas
      function processImageFile(file, maxWidth = 900) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onerror = reject;
          reader.onload = () => {
            const img = new Image();
            img.onerror = reject;
            img.onload = () => {
              const scale = Math.min(1, maxWidth / img.width);
              const canvas = document.createElement('canvas');
              canvas.width = Math.round(img.width * scale);
              canvas.height = Math.round(img.height * scale);
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
              resolve(canvas.toDataURL('image/jpeg', 0.82));
            };
            img.src = reader.result;
          };
          reader.readAsDataURL(file);
        });
      }

      // Générateur d'images illustrées sur Canvas (pour Démo Une & Galerie initiale)
      function createIllustratedCanvasImage({ bg1, bg2, emoji, title, subtitle }) {
        const c = document.createElement('canvas');
        c.width = 800;
        c.height = 540;
        const ctx = c.getContext('2d');
        const grad = ctx.createLinearGradient(0, 0, 800, 540);
        grad.addColorStop(0, bg1);
        grad.addColorStop(1, bg2);
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, 800, 540);

        // Motifs pop en arrière-plan
        ctx.fillStyle = 'rgba(255,255,255,0.16)';
        ctx.beginPath(); ctx.arc(130, 120, 95, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(690, 420, 130, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = 'rgba(0,0,0,0.08)';
        ctx.fillRect(40, 40, 720, 460);

        // Emoji central géant
        ctx.font = '150px serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(emoji, 400, 225);

        // Bandeau titre
        ctx.fillStyle = 'rgba(0,0,0,0.72)';
        ctx.fillRect(80, 355, 640, 110);
        ctx.fillStyle = '#FFFFFF';
        ctx.font = 'bold 34px Inter, sans-serif';
        ctx.fillText(title, 400, 396);
        ctx.fillStyle = '#FDE047';
        ctx.font = '600 22px Inter, sans-serif';
        ctx.fillText(subtitle, 400, 438);

        return c.toDataURL('image/jpeg', 0.85);
      }

      function applyTheme() {
        const isDark = state.settings.theme === 'dark';
        document.documentElement.classList.toggle('dark', isDark);
        document.querySelector('meta[name="theme-color"]').setAttribute('content', isDark ? '#09090B' : '#FFFFFF');
        document.getElementById('themeIcon').textContent = isDark ? '☀️' : '🌙';
        document.getElementById('themeLabel').textContent = isDark ? 'Clarté' : 'Onyx';
      }

      function updateModeBadge() {
        const badge = document.getElementById('modeBadge');
        if (state.settings.provider === 'gemini' && state.settings.apiKey.trim()) badge.textContent = 'Gemini';
        else if (state.settings.provider === 'mistral' && state.settings.apiKey.trim()) badge.textContent = 'Mistral';
        else badge.textContent = 'Démo';
      }

      const TAB_STYLES = {
        tribunal: 'bg-red-600 text-white border-black dark:bg-red-500 dark:text-black dark:border-red-300',
        une: 'bg-yellow-400 text-black border-black dark:bg-yellow-400 dark:text-black dark:border-yellow-200',
        defi: 'bg-blue-700 text-white border-black dark:bg-blue-400 dark:text-black dark:border-blue-200',
      };

      function switchTab(tabName) {
        state.activeTab = tabName;
        stopSpeaking();
        stopPlayerRecording();

        document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
        document.getElementById(`tab-${tabName}`).classList.remove('hidden');

        document.querySelectorAll('.nav-btn').forEach(btn => {
          const isCurrent = btn.dataset.tab === tabName;
          btn.className = `nav-btn min-h-[56px] rounded-2xl flex flex-col items-center justify-center gap-0.5 font-black text-xs transition border-2 ${
            isCurrent
              ? TAB_STYLES[tabName]
              : 'border-transparent text-zinc-700 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-900'
          }`;
          btn.setAttribute('aria-current', isCurrent ? 'page' : 'false');
        });
      }

      /* ============================================================
         4. CLIENT API IA UNIFIÉ (GEMINI / MISTRAL / MODE DÉMO)
         ============================================================ */
      async function callAI({ systemPrompt, userPrompt, expectJson = true }) {
        const { provider, apiKey } = state.settings;
        if (provider === 'demo' || !apiKey.trim()) return null;

        try {
          if (provider === 'gemini') {
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${encodeURIComponent(apiKey.trim())}`;
            const body = {
              systemInstruction: { parts: [{ text: systemPrompt }] },
              contents: [{ role: 'user', parts: [{ text: userPrompt }] }],
            };
            if (expectJson) body.generationConfig = { responseMimeType: 'application/json' };
            const res = await fetch(url, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (!res.ok) throw new Error('Gemini API error');
            const data = await res.json();
            return data.candidates?.[0]?.content?.parts?.[0]?.text || null;
          } else if (provider === 'mistral') {
            const res = await fetch('https://api.mistral.ai/v1/chat/completions', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${apiKey.trim()}`,
              },
              body: JSON.stringify({
                model: 'mistral-small-latest',
                messages: [
                  { role: 'system', content: systemPrompt },
                  { role: 'user', content: userPrompt },
                ],
                response_format: expectJson ? { type: 'json_object' } : undefined,
              }),
            });
            if (!res.ok) throw new Error('Mistral API error');
            const data = await res.json();
            return data.choices?.[0]?.message?.content || null;
          }
        } catch (err) {
          console.warn('Fallback Mode Démo:', err);
          showToast('API indisponible : utilisation du Mode Démo !');
          return null;
        }
        return null;
      }

      /* ============================================================
         5. EXPORT CANVAS HAUTE RÉSOLUTION & PARTAGE WHATSAPP / PNG
         ============================================================ */
      function wrapCanvasText(ctx, text, x, y, maxWidth, lineHeight, maxLines = 30) {
        const paragraphs = String(text || '').split('\n');
        let curY = y;
        let totalLines = 0;

        for (const para of paragraphs) {
          const words = para.split(/\s+/);
          let line = '';
          for (let i = 0; i < words.length; i++) {
            const testLine = line ? `${line} ${words[i]}` : words[i];
            if (ctx.measureText(testLine).width > maxWidth && line) {
              ctx.fillText(line, x, curY);
              curY += lineHeight;
              totalLines++;
              line = words[i];
              if (totalLines >= maxLines) return curY;
            } else {
              line = testLine;
            }
          }
          if (line) {
            ctx.fillText(line, x, curY);
            curY += lineHeight;
            totalLines++;
          }
          curY += lineHeight * 0.25;
        }
        return curY;
      }

      async function shareOrDownloadCanvas(canvas, filename, shareTitle) {
        return new Promise((resolve) => {
          canvas.toBlob(async (blob) => {
            if (!blob) {
              showToast('Erreur lors de la génération PNG.');
              return resolve();
            }
            const file = new File([blob], filename, { type: 'image/png' });
            if (navigator.share && navigator.canShare && navigator.canShare({ files: [file] })) {
              try {
                await navigator.share({
                  title: shareTitle,
                  text: 'Créé avec Le Bazar · Alphabette',
                  files: [file],
                });
                showToast('✅ Image partagée !');
                return resolve();
              } catch (err) {
                if (err.name === 'AbortError') return resolve();
              }
            }
            // Téléchargement PNG direct
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
            showToast('📥 Image PNG téléchargée !');
            resolve();
          }, 'image/png');
        });
      }

