      function renderCurrentChallenge() {
        const ch = LOCAL_CHALLENGES[state.currentChallengeIdx];
        document.getElementById('heading-defi').textContent = `« ${ch.title} »`;
        document.getElementById('defiHint').textContent = ch.hint;
      }

      document.getElementById('btnNextChallenge').addEventListener('click', () => {
        let next = Math.floor(Math.random() * LOCAL_CHALLENGES.length);
        if (next === state.currentChallengeIdx) next = (next + 1) % LOCAL_CHALLENGES.length;
        state.currentChallengeIdx = next;
        renderCurrentChallenge();
      });

      document.getElementById('defiFileInput').addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        SoundEngine.playShutter();
        try {
          state.defiPhotoDataUrl = await processImageFile(file, 820);
          const img = document.getElementById('defiPhotoPreview');
          img.src = state.defiPhotoDataUrl;
          img.classList.remove('hidden');
          document.getElementById('defiPhotoPlaceholder').classList.add('hidden');
        } catch {
          showToast('Erreur de lecture photo.');
        }
      });

      document.getElementById('btnPublishDefi').addEventListener('click', () => {
        const title = document.getElementById('defiTitleInput').value.trim();
        const city = document.getElementById('defiCityInput').value.trim() || 'Mon quartier';
        if (!state.defiPhotoDataUrl) {
          showToast('Prenez ou choisissez d’abord une photo !');
          return;
        }
        if (!title) {
          showToast('Ajoutez un titre court à votre photo.');
          return;
        }

        const ch = LOCAL_CHALLENGES[state.currentChallengeIdx];
        state.gallery.unshift({
          id: `post-${Date.now()}`,
          title,
          city,
          challenge: ch.title,
          image: state.defiPhotoDataUrl,
          reactions: { artiste: false, bienvu: false, poetique: false },
          isDemo: false,
        });

        // Reset formulaire
        state.defiPhotoDataUrl = null;
        document.getElementById('defiTitleInput').value = '';
        document.getElementById('defiFileInput').value = '';
        document.getElementById('defiPhotoPreview').classList.add('hidden');
        document.getElementById('defiPhotoPlaceholder').classList.remove('hidden');

        saveGallery();
        showToast('✨ Photo publiée dans la galerie locale !');
      });

      function renderGallery() {
        const list = document.getElementById('defiGallery');
        list.innerHTML = '';

        const REACTION_DEFS = [
          { key: 'artiste', label: '🎨 Œil d’artiste' },
          { key: 'bienvu', label: '👀 Bien vu' },
          { key: 'poetique', label: '✨ Poétique' },
        ];

        state.gallery.forEach(post => {
          const card = document.createElement('article');
          card.className = 'rounded-3xl overflow-hidden border-2 border-black dark:border-zinc-700 bg-white dark:bg-onyx-card shadow-pop-sm dark:shadow-none';

          card.innerHTML = `
            <img src="${post.image}" alt="${post.title.replace(/"/g, '&quot;')}" class="w-full max-h-72 object-cover border-b-2 border-black dark:border-zinc-700" />
            <div class="p-4 space-y-3">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class="inline-block text-[11px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-900 dark:bg-blue-500/20 dark:text-blue-300">
                    📍 ${post.city}
                  </span>
                  <h4 class="font-serif text-lg font-black mt-1 leading-snug"></h4>
                  <p class="text-xs font-semibold text-zinc-600 dark:text-zinc-400 mt-0.5"></p>
                </div>
                ${!post.isDemo ? `<button type="button" aria-label="Supprimer cette publication" class="del-post-btn min-w-[44px] min-h-[44px] rounded-xl border-2 border-zinc-300 dark:border-zinc-700 text-sm hover:bg-red-100 dark:hover:bg-red-900/40">🗑️</button>` : ''}
              </div>
              <div class="flex flex-wrap gap-2 pt-1">
                ${REACTION_DEFS.map(r => {
                  const active = post.reactions?.[r.key];
                  return `<button type="button" data-react="${r.key}" class="react-btn min-h-[44px] px-3.5 rounded-xl border-2 font-extrabold text-xs transition ${
                    active
                      ? 'bg-yellow-300 text-black border-black dark:bg-yellow-400 dark:text-black dark:border-yellow-200 shadow-pop-sm'
                      : 'bg-zinc-50 dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 border-zinc-300 dark:border-zinc-700 hover:border-black'
                  }">${r.label}</button>`;
                }).join('')}
              </div>
            </div>
          `;

          card.querySelector('h4').textContent = post.title;
          card.querySelector('p').textContent = `Défi : ${post.challenge}`;

          card.querySelectorAll('.react-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const k = btn.dataset.react;
              post.reactions[k] = !post.reactions[k];
              saveGallery();
            });
          });

          const delBtn = card.querySelector('.del-post-btn');
          if (delBtn) {
            delBtn.addEventListener('click', () => {
              state.gallery = state.gallery.filter(item => item.id !== post.id);
              saveGallery();
              showToast('Photo retirée de la galerie.');
            });
          }

          list.appendChild(card);
        });
      }

