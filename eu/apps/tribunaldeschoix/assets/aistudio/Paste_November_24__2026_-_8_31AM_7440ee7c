        ta.value = pool[Math.floor(Math.random() * pool.length)];
      });

      // Dictée micro pour La Une
      document.getElementById('btnUneMic').addEventListener('click', (e) => {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) {
          showToast('Dictée vocale indisponible sur ce navigateur.');
          return;
        }
        const btn = e.currentTarget;
        const rec = new SpeechRecognition();
        rec.lang = 'fr-FR';
        rec.interimResults = false;
        btn.classList.add('mic-recording');
        showToast('🎙️ Dictez votre anecdote...');
        rec.onresult = (ev) => {
          const text = ev.results[0][0].transcript;
          const ta = document.getElementById('uneAnecdote');
          ta.value = ta.value ? `${ta.value} ${text}` : text;
        };
        rec.onerror = () => showToast('Erreur micro.');
        rec.onend = () => btn.classList.remove('mic-recording');
        rec.start();
      });

      function buildDemoUne(anecdote) {
        const clean = anecdote.trim() || DEMO_ANECDOTES[0];
        const shortLead = clean.split(/[.!?]/)[0].trim();
        const headlines = [
          'STUPÉFACTION GÉNÉRALE : UN INCIDENT DU QUOTIDIEN FAIT TREMBLER LE QUARTIER !',
          'EXCLUSIF : LA VÉRITÉ ÉCLATE ENFIN SUR CETTE AFFAIRE HORS NORMES !',
          'SCANDALE DE PROXIMITÉ : LES TÉMOINS N’EN CROIENT TOUJOURS PAS LEURS YEUX !',
        ];
        const weathers = [
          'Soleil radieux avec 80% de risques de mauvaise foi en fin de journée et rafales d’apéro vers 19h.',
          'Ciel dégagé, légère brise d’ironie venant du sud et averses soudaines de fous rires localisés.',
          'Températures idéales pour débattre de tout et de rien, pression atmosphérique en hausse près de la machine à café.',
        ];
        return {
          headline: headlines[Math.floor(Math.random() * headlines.length)],
          subtitle: `Retour en urgence sur cet événement historique : « ${shortLead.slice(0, 95)}${shortLead.length > 95 ? '...' : ''} »`,
          caption: 'Cliché d’archive pris quelques secondes avant que tout le monde n’éclate de rire (DR / Le Bazar).',
          article: `D'après nos envoyés très spéciaux dépêchés sur place en trottinette, personne ne s'attendait à une telle tournure des événements. ${clean} Les experts internationaux, immédiatement contactés par notre rédaction, parlent déjà d'un « tournant majeur pour le moral du voisinage ».\n\nMalgré l'émotion palpable, une cellule de soutien psychologique équipée de croissants chauds a été déployée. La population reste mobilisée dans le calme et la bonne humeur en attendant le prochain rebondissement.`,
          weather: weathers[Math.floor(Math.random() * weathers.length)],
        };
      }

      document.getElementById('btnPrintUne').addEventListener('click', async () => {
        stopSpeaking();
        const anecdote = document.getElementById('uneAnecdote').value.trim();
        if (!anecdote) {
          showToast('Écrivez une anecdote ou cliquez sur « 🎲 Anecdote démo ».');
          return;
        }
        if (!state.unePhotoDataUrl) {
          // Génère automatiquement une photo démo si l'utilisateur n'en a pas choisi
          state.unePhotoDataUrl = createIllustratedCanvasImage({
            bg1: '#DC2626', bg2: '#F59E0B', emoji: '🗞️', title: 'FLASH SPÉCIAL', subtitle: 'Image exclusive de la rédaction'
          });
        }

        const card = document.getElementById('newspaperCard');
        card.classList.remove('hidden');
        document.getElementById('newsHeadline').textContent = 'IMPRESSION EN COURS...';
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        let data = null;
        const aiText = await callAI({
          systemPrompt: "Tu es rédacteur en chef d'un journal satirique français délirant et bienveillant. Transforme cette petite anecdote banale en Une sensationnaliste hilarante. Réponds en JSON strict avec les clés : 'headline' (gros titre choc en MAJUSCULES, max 12 mots), 'subtitle' (sous-titre dramatique), 'caption' (légende photo décalée), 'article' (début d'article journalistique absurde de 85 à 115 mots), 'weather' (météo absurde du jour en 1 phrase).",
          userPrompt: `Anecdote : ${anecdote}`,
          expectJson: true,
        });
        if (aiText) {
          try { data = JSON.parse(aiText); } catch {}
        }
        if (!data || !data.headline) {
          data = buildDemoUne(anecdote);
        }

        const todayStr = new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        state.currentUne = { ...data, date: todayStr };

        document.getElementById('newsDate').textContent = todayStr;
        document.getElementById('newsHeadline').textContent = data.headline;
        document.getElementById('newsSubtitle').textContent = data.subtitle;
        document.getElementById('newsPhoto').src = state.unePhotoDataUrl;
        document.getElementById('newsCaption').textContent = data.caption;
        document.getElementById('newsArticle').textContent = data.article;
        document.getElementById('newsWeather').textContent = data.weather;
      });

      document.getElementById('btnFlashInfo').addEventListener('click', () => {
        if (!state.currentUne) return;
        stopSpeaking();
        SoundEngine.playNewsJingle();
        setTimeout(() => {
          const u = state.currentUne;
          speakText(`Flash info spécial Le Bazar du Jour ! ${u.headline}. ${u.subtitle}. ${u.article}. Et côté météo : ${u.weather}`);
        }, 1250);
      });

      document.getElementById('btnUneStopAudio').addEventListener('click', stopSpeaking);
      document.getElementById('btnUneDownload').addEventListener('click', () => {
        if (state.currentUne) exportNewspaperPNG(state.currentUne, state.unePhotoDataUrl);
      });

      /* ============================================================
         8. MODULE 3 : DÉFI MICRO-LOCAL (GALERIE BIENVEILLANTE)
         ============================================================ */
      const LOCAL_CHALLENGES = [
        { title: 'La porte la plus colorée du quartier', hint: 'Ouvrez l’œil sur les façades anciennes ou les entrées cachées.' },
        { title: 'Un reflet insolite dans une vitrine ou une flaque', hint: 'Cherchez un double monde inversé au ras du sol ou sur le verre.' },
        { title: 'Une enseigne rétro pleine de charme', hint: 'Typographie vintage, néon oublié ou devanture d’artisan.' },
        { title: 'Une ombre qui raconte une histoire', hint: 'Jouez avec la lumière rasante du matin ou de fin d’après-midi.' },
        { title: 'Un arbre ou une fleur qui défie le béton', hint: 'La nature qui reprend doucement ses droits en ville.' },
        { title: 'Une boîte aux lettres pleine de caractère', hint: 'Peinte à la main, penchée ou décorée avec humour.' },
