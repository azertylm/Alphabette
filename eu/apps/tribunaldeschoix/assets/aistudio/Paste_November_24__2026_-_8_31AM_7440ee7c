<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="theme-color" content="#FFFFFF" />
  <meta name="description" content="Le Bazar par Alphabette — Studio d'humour, tribunal des petits riens, fausses Unes de presse satirique et défis photo locaux." />
  <title>Le Bazar — Alphabette</title>

  <!-- Polices éditoriales & UI : Playfair Display (Presse Satirique) + Inter (Lisibilité WCAG AAA) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            serif: ['Playfair Display', 'Georgia', 'serif'],
          },
          colors: {
            onyx: {
              bg: '#09090B',
              card: '#18181B',
              border: '#27272A',
              muted: '#A1A1AA',
            },
            paper: '#FAF8F5',
          },
          boxShadow: {
            pop: '4px 4px 0px 0px #000000',
            'pop-sm': '2px 2px 0px 0px #000000',
            'pop-dark': '4px 4px 0px 0px #FACC15',
          }
        }
      }
    };
  </script>

  <style>
    /* Base & confort tactile mobile */
    html, body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      -webkit-tap-highlight-color: transparent;
      overscroll-behavior-y: none;
    }

    /* Focus haute visibilité (WCAG AAA) */
    *:focus-visible {
      outline: 3px solid #2563EB;
      outline-offset: 2px;
    }
    .dark *:focus-visible {
      outline: 3px solid #FDE047;
    }

    /* Animation onde micro active */
    @keyframes micPulse {
      0% { transform: scale(0.97); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.75); }
      70% { transform: scale(1); box-shadow: 0 0 0 14px rgba(220, 38, 38, 0); }
      100% { transform: scale(0.97); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
    }
    .mic-recording {
      animation: micPulse 1.2s infinite;
    }

    /* Texture subtile papier journal en mode Clarté */
    .newsprint-bg {
      background-color: #FAF8F5;
      background-image: radial-gradient(rgba(0, 0, 0, 0.04) 1px, transparent 0);
      background-size: 16px 16px;
    }
    .dark .newsprint-bg {
      background-color: #18181B;
      background-image: radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 0);
    }

    /* Masquer les scrollbars horizontales */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-white text-black dark:bg-onyx-bg dark:text-zinc-50 min-h-screen flex flex-col transition-colors duration-200 selection:bg-yellow-300 selection:text-black">

  <!-- ==================== EN-TÊTE FIXE ==================== -->
  <header class="sticky top-0 z-40 bg-white/95 dark:bg-onyx-bg/95 backdrop-blur-md border-b-2 border-black dark:border-zinc-700 px-4 py-3">
    <div class="max-w-2xl mx-auto flex items-center justify-between gap-2">
      <!-- Identité Presse Satirique & Pop -->
      <div class="flex items-center gap-3">
        <div id="brandBadge" class="w-11 h-11 rounded-2xl bg-yellow-400 text-black border-2 border-black dark:border-yellow-300 flex items-center justify-center font-serif font-black text-2xl shadow-pop-sm transition-colors">
          B
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-serif text-2xl font-black tracking-tight leading-none">Le Bazar</h1>
            <span id="modeBadge" class="text-[11px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full border border-black dark:border-yellow-400 bg-yellow-300 text-black dark:bg-yellow-400/20 dark:text-yellow-300">
              Démo
            </span>
          </div>
          <p class="text-xs font-bold text-zinc-700 dark:text-zinc-400 mt-0.5">Studio Satirique · Alphabette</p>
        </div>
      </div>

      <!-- Actions : Switch Thème & Paramètres -->
      <div class="flex items-center gap-2">
        <button
          id="btnThemeToggle"
          type="button"
          aria-label="Basculer entre le mode Clarté et le mode Onyx"
          class="min-w-[48px] min-h-[48px] px-3 rounded-2xl border-2 border-black dark:border-zinc-600 bg-zinc-100 dark:bg-onyx-card hover:bg-yellow-200 dark:hover:bg-zinc-800 flex items-center justify-center gap-1.5 font-extrabold text-xs sm:text-sm transition"
        >
          <span id="themeIcon" aria-hidden="true">🌙</span>
          <span id="themeLabel" class="hidden sm:inline">Onyx</span>
        </button>

        <button
          id="btnOpenSettings"
          type="button"
          aria-label="Ouvrir les paramètres IA et voix"
          class="min-w-[48px] min-h-[48px] rounded-2xl border-2 border-black dark:border-zinc-600 bg-zinc-100 dark:bg-onyx-card hover:bg-yellow-200 dark:hover:bg-zinc-800 flex items-center justify-center text-xl transition"
        >
          ⚙️
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== CONTENU PRINCIPAL ==================== -->
  <main class="flex-1 w-full max-w-2xl mx-auto px-4 pt-5 pb-28">

    <!-- ==================== MODULE 1 : LE TRIBUNAL DES PETITS RIENS ==================== -->
    <section id="tab-tribunal" class="tab-panel space-y-5" aria-labelledby="heading-tribunal">
      <!-- Bannière d'introduction -->
      <div class="rounded-3xl p-5 border-2 border-black dark:border-red-500/70 bg-red-50 dark:bg-onyx-card shadow-pop dark:shadow-none space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full bg-red-600 text-white dark:bg-red-500 dark:text-black">
            ⚖️ Audience Ouverte
          </span>
          <!-- Sélecteur 2 ou 3 joueurs -->
          <div class="inline-flex rounded-xl border-2 border-black dark:border-zinc-600 overflow-hidden bg-white dark:bg-zinc-900" role="group" aria-label="Nombre de joueurs">
            <button type="button" data-players="2" class="player-count-btn min-h-[40px] px-3.5 font-extrabold text-xs transition">2 joueurs</button>
            <button type="button" data-players="3" class="player-count-btn min-h-[40px] px-3.5 font-extrabold text-xs transition border-l-2 border-black dark:border-zinc-600">3 joueurs</button>
          </div>
        </div>

        <div>
          <h2 id="heading-tribunal" class="font-serif text-2xl sm:text-3xl font-black tracking-tight leading-tight">
            Le Tribunal des Petits Riens
          </h2>
          <p class="text-sm font-semibold text-zinc-800 dark:text-zinc-300 mt-1">
            Chacun plaide sa cause en 30 secondes. Le Juge tranche sans pitié et inflige un gage absurde.
          </p>
        </div>

        <!-- Sujet du litige -->
        <div class="space-y-2">
          <label for="tribunalSubject" class="block text-xs font-black uppercase tracking-wider text-zinc-900 dark:text-zinc-200">
            Sujet du litige
          </label>
          <div class="flex flex-col sm:flex-row gap-2">
            <input
              id="tribunalSubject"
              type="text"
              value="Le rangement stratégique du lave-vaisselle"
              placeholder="Ex : Pain au chocolat vs Chocolatine..."
              class="flex-1 min-h-[50px] px-4 rounded-2xl border-2 border-black dark:border-zinc-600 bg-white dark:bg-zinc-950 font-bold text-sm sm:text-base placeholder:text-zinc-500"
            />
            <button
              id="btnRandomSubject"
              type="button"
              class="min-h-[50px] px-4 rounded-2xl border-2 border-black dark:border-yellow-400 bg-yellow-400 hover:bg-yellow-300 text-black font-black text-sm whitespace-nowrap shadow-pop-sm active:translate-y-0.5 transition"
            >
              🎲 Sujet absurde
            </button>
          </div>
        </div>
      </div>

      <!-- Cartes de plaidoirie des joueurs (générées par JS) -->
      <div id="playersContainer" class="space-y-4"></div>

      <!-- Sélecteur de personnalité du Juge IA -->
      <div class="rounded-3xl p-5 border-2 border-black dark:border-zinc-700 bg-white dark:bg-onyx-card space-y-3">
        <p class="text-xs font-black uppercase tracking-wider text-zinc-800 dark:text-zinc-300">
          Choisissez votre Juge IA :
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5" role="radiogroup" aria-label="Personnalité du juge">
          <button type="button" data-judge="solennel" class="judge-btn min-h-[64px] p-3 rounded-2xl border-2 text-left flex sm:flex-col items-center sm:items-start gap-2.5 transition">
            <span class="text-2xl" aria-hidden="true">🏛️</span>
            <div>
              <p class="font-black text-sm leading-tight">Magistrat Ultra-Solennel</p>
              <p class="text-[11px] font-semibold opacity-80">Code civil & grandiloquence</p>
            </div>
          </button>
          <button type="button" data-judge="satiriste" class="judge-btn min-h-[64px] p-3 rounded-2xl border-2 text-left flex sm:flex-col items-center sm:items-start gap-2.5 transition">
            <span class="text-2xl" aria-hidden="true">😏</span>
            <div>
              <p class="font-black text-sm leading-tight">Satiriste Grinçant</p>
              <p class="text-[11px] font-semibold opacity-80">Ironie mordante & piques</p>
            </div>
          </button>
          <button type="button" data-judge="sportif" class="judge-btn min-h-[64px] p-3 rounded-2xl border-2 text-left flex sm:flex-col items-center sm:items-start gap-2.5 transition">
            <span class="text-2xl" aria-hidden="true">📣</span>
            <div>
              <p class="font-black text-sm leading-tight">Commentateur Sportif</p>
              <p class="text-[11px] font-semibold opacity-80">Hystérique & VAR du litige</p>
            </div>
          </button>
        </div>

        <!-- Bouton principal : Rendre le Verdict -->
        <button
          id="btnRenderVerdict"
          type="button"
          class="w-full min-h-[58px] mt-2 rounded-2xl border-2 border-black dark:border-red-400 bg-red-600 hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-400 text-white dark:text-black font-black text-lg flex items-center justify-center gap-2.5 shadow-pop dark:shadow-none active:translate-y-0.5 transition"
        >
          <span aria-hidden="true">⚖️</span>
          <span>Rendre le Verdict</span>
        </button>
      </div>

      <!-- Résultat : ARRÊT DU TRIBUNAL -->
      <article id="verdictCard" class="hidden rounded-3xl p-5 sm:p-6 border-4 border-black dark:border-yellow-400 newsprint-bg shadow-pop dark:shadow-none space-y-4">
        <div class="border-b-2 border-black dark:border-zinc-600 pb-3 flex items-center justify-between gap-2">
          <div>
            <p id="verdictCaseNumber" class="text-xs font-black uppercase tracking-widest text-red-700 dark:text-red-400"></p>
            <h3 class="font-serif text-2xl sm:text-3xl font-black uppercase tracking-tight">Arrêt du Tribunal</h3>
          </div>
          <span id="verdictJudgeIcon" class="text-3xl" aria-hidden="true">⚖️</span>
        </div>

        <p id="verdictJudgeLabel" class="text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-black text-white dark:bg-zinc-800 dark:text-yellow-300 inline-block"></p>

        <p id="verdictBody" class="text-base font-semibold leading-relaxed whitespace-pre-line text-zinc-900 dark:text-zinc-100"></p>

        <!-- Encadré Rouge : LE COUPABLE DÉSIGNÉ -->
        <div class="p-4 rounded-2xl border-2 border-red-700 bg-red-600 text-white dark:bg-red-500/20 dark:border-red-400 dark:text-red-200">
          <p class="text-xs font-black uppercase tracking-widest opacity-95">🚨 Le Coupable Désigné</p>
          <p id="verdictCulprit" class="font-serif text-xl sm:text-2xl font-black mt-1"></p>
        </div>

        <!-- Encadré Jaune : GAGE SYMBOLIQUE ABSURDE -->
        <div class="p-4 rounded-2xl border-2 border-black dark:border-yellow-400 bg-yellow-300 text-black dark:bg-yellow-400/20 dark:text-yellow-200">
          <p class="text-xs font-black uppercase tracking-widest">🎭 Gage Symbolique Absurde</p>
          <p id="verdictForfeit" class="font-extrabold text-base mt-1 leading-snug"></p>
        </div>

        <!-- Boutons d'action Verdict -->
        <div class="flex flex-wrap items-center gap-2.5 pt-2 border-t-2 border-black/20 dark:border-zinc-700">
          <button id="btnVerdictSpeak" type="button" class="flex-1 min-h-[50px] px-4 rounded-2xl border-2 border-black dark:border-zinc-500 bg-white dark:bg-zinc-900 font-black text-sm flex items-center justify-center gap-2 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition">
            🔊 Écouter le verdict
          </button>
          <button id="btnVerdictStop" type="button" aria-label="Arrêter la lecture" class="min-w-[50px] min-h-[50px] px-3 rounded-2xl border-2 border-black dark:border-zinc-500 bg-white dark:bg-zinc-900 font-black text-sm">
            ⏹️
          </button>
          <button id="btnVerdictShare" type="button" class="w-full sm:w-auto flex-1 min-h-[50px] px-4 rounded-2xl border-2 border-black dark:border-yellow-400 bg-yellow-400 hover:bg-yellow-300 text-black font-black text-sm flex items-center justify-center gap-2 shadow-pop-sm transition">
            📥 Partager l'arrêt (PNG)
          </button>
        </div>
      </article>
    </section>

    <!-- ==================== MODULE 2 : LA UNE DE L'ABSURDE ==================== -->
    <section id="tab-une" class="tab-panel hidden space-y-5" aria-labelledby="heading-une">
      <div class="rounded-3xl p-5 border-2 border-black dark:border-yellow-400/70 bg-yellow-50 dark:bg-onyx-card shadow-pop dark:shadow-none space-y-4">
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full bg-black text-yellow-300 dark:bg-yellow-400 dark:text-black">
            📰 Presse Satirique
          </span>
          <span class="text-xs font-extrabold text-zinc-700 dark:text-zinc-400">Édition Spéciale</span>
        </div>

        <div>
          <h2 id="heading-une" class="font-serif text-2xl sm:text-3xl font-black tracking-tight leading-tight">
            La Une de l'Absurde
          </h2>
          <p class="text-sm font-semibold text-zinc-800 dark:text-zinc-300 mt-1">
            Transformez une photo banale et deux phrases du quotidien en scandale planétaire à la Une !
          </p>
        </div>

        <!-- Zone Photo -->
        <div class="space-y-2.5">
          <label
            for="uneFileInput"
            class="block cursor-pointer rounded-2xl border-2 border-dashed border-black dark:border-yellow-400 bg-white dark:bg-zinc-950 p-4 text-center hover:bg-yellow-100/50 dark:hover:bg-zinc-900 transition"
          >
            <input id="uneFileInput" type="file" accept="image/*" capture="environment" class="sr-only" />
            <div id="unePhotoPlaceholder" class="py-4 space-y-1.5">
              <div class="text-4xl" aria-hidden="true">📷</div>
              <p class="font-black text-base">Prendre ou importer une photo</p>
              <p class="text-xs font-semibold text-zinc-600 dark:text-zinc-400">Un repas, une partie de pétanque, un vélo cassé...</p>
            </div>
            <img id="unePhotoPreview" alt="Aperçu pour la Une du journal" class="hidden max-h-60 mx-auto rounded-xl object-cover border-2 border-black dark:border-zinc-700" />
          </label>

          <button
            id="btnUneDemoPhoto"
            type="button"
            class="w-full min-h-[48px] px-4 rounded-2xl border-2 border-black dark:border-zinc-600 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 font-extrabold text-sm transition"
          >
            🎨 Utiliser une photo démo illustrée
          </button>
        </div>

        <!-- Zone Anecdote -->
        <div class="space-y-2">
          <div class="flex items-center justify-between gap-2">
            <label for="uneAnecdote" class="text-xs font-black uppercase tracking-wider">
              Votre anecdote (2 phrases)
            </label>
            <button
              id="btnUneDemoAnecdote"
              type="button"
              class="min-h-[38px] px-3 rounded-xl border-2 border-black dark:border-zinc-600 bg-white dark:bg-zinc-900 font-extrabold text-xs hover:bg-yellow-200 dark:hover:bg-zinc-800 transition"
            >
              🎲 Anecdote démo
            </button>
          </div>
          <div class="flex gap-2 items-start">
            <textarea
              id="uneAnecdote"
              rows="3"
              placeholder="Ex : Tonton Michel a encore raté le cochonnet de trois mètres et a accusé le vent marin..."
              class="flex-1 p-3.5 rounded-2xl border-2 border-black dark:border-zinc-600 bg-white dark:bg-zinc-950 font-semibold text-sm sm:text-base placeholder:text-zinc-500"
            ></textarea>
            <button
              id="btnUneMic"
              type="button"
              aria-label="Dicter votre anecdote au micro"
              class="min-w-[52px] min-h-[52px] rounded-2xl border-2 border-black dark:border-zinc-600 bg-red-600 text-white font-black text-xl flex items-center justify-center shadow-pop-sm transition"
            >
              🎙️
            </button>
          </div>
        </div>

        <!-- Bouton Imprimer la Une -->
        <button
          id="btnPrintUne"
          type="button"
          class="w-full min-h-[58px] rounded-2xl border-2 border-black dark:border-yellow-400 bg-black dark:bg-yellow-400 text-yellow-300 dark:text-black font-black text-lg flex items-center justify-center gap-2.5 shadow-pop dark:shadow-none active:translate-y-0.5 transition"
        >
          <span aria-hidden="true">📰</span>
          <span>Imprimer la Une</span>
        </button>
      </div>

      <!-- Résultat : FAUSSE UNE DE JOURNAL SATIRIQUE -->
      <article id="newspaperCard" class="hidden rounded-3xl p-5 sm:p-6 border-4 border-black dark:border-zinc-500 newsprint-bg shadow-pop dark:shadow-none space-y-4">
        <!-- Masthead Journal -->
        <div class="border-b-4 border-double border-black dark:border-zinc-500 pb-2 text-center">
          <div class="flex items-center justify-between text-[10px] sm:text-xs font-black uppercase tracking-widest border-b border-black dark:border-zinc-600 pb-1 mb-1.5">
            <span>Édition Spéciale</span>
            <span id="newsDate"></span>
            <span>Prix : 1 Sourire</span>
          </div>
          <h3 class="font-serif text-3xl sm:text-4xl font-black uppercase tracking-tight leading-none">
            LE BAZAR DU JOUR
          </h3>
          <p class="text-[11px] font-bold italic text-zinc-700 dark:text-zinc-400 mt-1">
            « L'information vérifiée à peu près, dramatisée avec passion »
          </p>
        </div>

        <!-- Gros Titre Choc & Sous-titre -->
        <div class="space-y-1.5 text-center">
          <h4 id="newsHeadline" class="font-serif text-2xl sm:text-3xl font-black uppercase leading-tight text-red-700 dark:text-red-400"></h4>
          <p id="newsSubtitle" class="font-serif italic text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-200"></p>
        </div>

        <!-- Photo & Légende -->
        <figure class="space-y-1.5">
          <img id="newsPhoto" alt="Photo de la Une" class="w-full max-h-72 object-cover rounded-xl border-2 border-black dark:border-zinc-600" />
          <figcaption id="newsCaption" class="text-xs font-bold italic text-zinc-700 dark:text-zinc-400 text-center"></figcaption>
        </figure>

        <!-- Article en 2 colonnes -->
        <div id="newsArticle" class="columns-1 sm:columns-2 gap-5 text-sm font-medium leading-relaxed text-justify text-zinc-900 dark:text-zinc-100 border-t-2 border-black/20 dark:border-zinc-700 pt-3"></div>

        <!-- Encart Météo Absurde du Jour -->
        <div class="p-3.5 rounded-2xl border-2 border-black dark:border-blue-400 bg-blue-100 dark:bg-blue-500/20 text-black dark:text-blue-100 flex items-start gap-3">
          <span class="text-2xl leading-none" aria-hidden="true">🌦️</span>
          <div>
            <p class="text-xs font-black uppercase tracking-wider">Météo Absurde du Jour</p>
            <p id="newsWeather" class="text-sm font-bold mt-0.5"></p>
          </div>
        </div>

        <!-- Boutons d'action Une -->
        <div class="flex flex-wrap items-center gap-2.5 pt-2 border-t-2 border-black/20 dark:border-zinc-700">
          <button id="btnFlashInfo" type="button" class="flex-1 min-h-[50px] px-4 rounded-2xl border-2 border-black dark:border-red-400 bg-red-600 hover:bg-red-700 dark:bg-red-500 text-white dark:text-black font-black text-sm flex items-center justify-center gap-2 transition">
            📺 Mode Flash Info
          </button>
          <button id="btnUneStopAudio" type="button" aria-label="Arrêter le Flash Info" class="min-w-[50px] min-h-[50px] px-3 rounded-2xl border-2 border-black dark:border-zinc-600 bg-white dark:bg-zinc-900 font-black text-sm">
            ⏹️
          </button>
          <button id="btnUneDownload" type="button" class="w-full sm:w-auto flex-1 min-h-[50px] px-4 rounded-2xl border-2 border-black dark:border-yellow-400 bg-yellow-400 hover:bg-yellow-300 text-black font-black text-sm flex items-center justify-center gap-2 shadow-pop-sm transition">
            📥 Télécharger la Une (PNG)
          </button>
        </div>
      </article>
    </section>

    <!-- ==================== MODULE 3 : DÉFI MICRO-LOCAL ==================== -->
    <section id="tab-defi" class="tab-panel hidden space-y-5" aria-labelledby="heading-defi">
      <!-- Carte du Défi de la semaine -->
      <div class="rounded-3xl p-5 border-2 border-black dark:border-blue-400/80 bg-blue-50 dark:bg-onyx-card shadow-pop dark:shadow-none space-y-4">
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full bg-blue-700 text-white dark:bg-blue-400 dark:text-black">
            📸 Défi Micro-Local
          </span>
          <span class="text-xs font-extrabold text-blue-900 dark:text-blue-300">Zéro algorithme</span>
        </div>

        <div class="p-4 rounded-2xl border-2 border-black dark:border-blue-400/50 bg-white dark:bg-zinc-950 space-y-2">
          <p class="text-xs font-black uppercase tracking-widest text-blue-700 dark:text-blue-400">Défi créatif actif</p>
          <h2 id="heading-defi" class="font-serif text-xl sm:text-2xl font-black leading-snug"></h2>
          <p id="defiHint" class="text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-400"></p>
        </div>

        <button
