      function exportNewspaperPNG(une, imgDataUrl) {
        const c = document.createElement('canvas');
        c.width = 1080;
        c.height = 1480;
        const ctx = c.getContext('2d');

        const drawRest = (loadedImg) => {
          // Fond papier journal
          ctx.fillStyle = '#FAF8F5';
          ctx.fillRect(0, 0, c.width, c.height);

          // Bordure presse
          ctx.strokeStyle = '#000000';
          ctx.lineWidth = 8;
          ctx.strokeRect(24, 24, c.width - 48, c.height - 48);

          // Masthead
          ctx.fillStyle = '#000000';
          ctx.font = '800 20px Inter, sans-serif';
          ctx.textAlign = 'left';
          ctx.fillText('ÉDITION SPÉCIALE', 56, 70);
          ctx.textAlign = 'center';
          ctx.fillText(une.date.toUpperCase(), 540, 70);
          ctx.textAlign = 'right';
          ctx.fillText('PRIX : 1 SOURIRE', 1024, 70);

          ctx.fillRect(56, 84, 968, 3);
          ctx.textAlign = 'center';
          ctx.font = '900 74px "Playfair Display", Georgia, serif';
          ctx.fillText('LE BAZAR DU JOUR', 540, 162);
          ctx.fillRect(56, 180, 968, 6);
          ctx.fillRect(56, 192, 968, 2);

          // Gros Titre Choc
          ctx.fillStyle = '#B91C1C';
          ctx.font = '900 46px "Playfair Display", Georgia, serif';
          let y = wrapCanvasText(ctx, une.headline.toUpperCase(), 540, 250, 950, 54, 3);

          // Sous-titre dramatique
          ctx.fillStyle = '#18181B';
          ctx.font = 'italic 700 26px "Playfair Display", Georgia, serif';
          y = wrapCanvasText(ctx, une.subtitle, 540, y + 6, 940, 34, 2);

          // Photo recadrée proprement (object-fit cover)
          const photoY = y + 14;
          const photoW = 968;
          const photoH = 420;
          if (loadedImg) {
            ctx.save();
            ctx.beginPath();
            ctx.rect(56, photoY, photoW, photoH);
            ctx.clip();
            const imgRatio = loadedImg.width / loadedImg.height;
            const boxRatio = photoW / photoH;
            let drawW = photoW, drawH = photoH, dx = 56, dy = photoY;
            if (imgRatio > boxRatio) {
              drawW = photoH * imgRatio;
              dx = 56 - (drawW - photoW) / 2;
            } else {
              drawH = photoW / imgRatio;
              dy = photoY - (drawH - photoH) / 2;
            }
            ctx.drawImage(loadedImg, dx, dy, drawW, drawH);
            ctx.restore();
          }
          ctx.strokeStyle = '#000000';
          ctx.lineWidth = 4;
          ctx.strokeRect(56, photoY, photoW, photoH);

          // Légende photo
          ctx.fillStyle = '#3F3F46';
          ctx.font = 'italic 700 21px Inter, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(une.caption, 540, photoY + photoH + 30);

          // Article en 2 colonnes
          const artY = photoY + photoH + 74;
          const words = une.article.split(/\s+/);
          const half = Math.ceil(words.length / 2);
          const col1 = words.slice(0, half).join(' ');
          const col2 = words.slice(half).join(' ');

          ctx.fillStyle = '#111827';
          ctx.font = '500 24px Inter, sans-serif';
          ctx.textAlign = 'left';
          wrapCanvasText(ctx, col1, 56, artY, 460, 33, 11);
          wrapCanvasText(ctx, col2, 560, artY, 464, 33, 11);

          // Filet vertical entre colonnes
          ctx.fillStyle = '#D4D4D8';
          ctx.fillRect(536, artY - 22, 2, 310);

          // Encart Météo Absurde
          const weatherY = 1260;
          ctx.fillStyle = '#DBEAFE';
          ctx.fillRect(56, weatherY, 968, 120);
          ctx.strokeStyle = '#000000';
          ctx.lineWidth = 3;
          ctx.strokeRect(56, weatherY, 968, 120);
          ctx.fillStyle = '#000000';
          ctx.font = '900 20px Inter, sans-serif';
          ctx.fillText('🌦️ MÉTÉO ABSURDE DU JOUR', 84, weatherY + 38);
          ctx.font = '700 23px Inter, sans-serif';
          wrapCanvasText(ctx, une.weather, 84, weatherY + 74, 912, 30, 2);

          // Filigrane bas de page
          ctx.fillStyle = '#52525B';
          ctx.font = '800 22px Inter, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Le Bazar · Alphabette — Studio Satirique', 540, 1425);

          shareOrDownloadCanvas(c, `une-le-bazar-${Date.now()}.png`, 'La Une de l’Absurde — Le Bazar');
        };

        if (imgDataUrl) {
          const img = new Image();
          img.onload = () => drawRest(img);
          img.onerror = () => drawRest(null);
          img.src = imgDataUrl;
        } else {
          drawRest(null);
        }
      }

