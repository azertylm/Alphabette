      function startPlayerRecording(idx) {
        if (state.recordingPlayerIdx === idx) {
          stopPlayerRecording();
          return;
        }
        stopPlayerRecording();
        state.recordingPlayerIdx = idx;

        let secondsLeft = 30;
        renderPlayers(secondsLeft);

        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (SpeechRecognition) {
          const rec = new SpeechRecognition();
          rec.lang = 'fr-FR';
          rec.continuous = true;
          rec.interimResults = true;
          const baseText = state.players[idx].plea ? state.players[idx].plea + ' ' : '';

          rec.onresult = (event) => {
            let transcript = '';
            for (let i = 0; i < event.results.length; i++) {
              transcript += event.results[i][0].transcript;
            }
            state.players[idx].plea = (baseText + transcript).trim();
            const ta = document.getElementById(`plea-${idx}`);
            if (ta) ta.value = state.players[idx].plea;
          };
          rec.onerror = () => showToast('Micro indisponible : vous pouvez saisir au clavier.');
          try { rec.start(); } catch {}
          state.activeRecognition = rec;
        } else {
          showToast('Dictée non supportée ici : chrono 30s lancé, saisissez au clavier !');
        }

        state.activeTimer = setInterval(() => {
          secondsLeft--;
          const timerEl = document.getElementById(`timer-${idx}`);
          if (timerEl) timerEl.textContent = `${secondsLeft}s`;
          if (secondsLeft <= 0) {
            SoundEngine.playGavel();
            showToast(`⏱️ Temps écoulé pour ${state.players[idx].name} !`);
            stopPlayerRecording();
          }
        }, 1000);
