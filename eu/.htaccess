# Généré par scripts/build-static.mjs — ne pas modifier à la main.
Options -Indexes -MultiViews
DirectoryIndex index.html
# Page 404 illustrée (Lot 4) : adresses de fichiers introuvables (apps/, labo/, api/…).
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(json|php)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Jeton « Authorization: Bearer » transmis à PHP (espace créateurs, api/billing.php…) : OVH le retire sinon.
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteBase /eu/

  # Le dossier eu/ n'est servi que sous le nom alphabette.eu
  RewriteCond %{HTTP_HOST} !^(www\.)?alphabette\.eu$ [NC]
  RewriteRule ^(.*)$ https://alphabette.eu/$1 [R=302,L]

  # Données privées éventuelles du service des avis : jamais servies
  RewriteRule ^api/donnees-privees - [F,L]

  # API publique figée au build + service des avis
  RewriteRule ^api/apps/?$ api/apps.json [L]
  RewriteRule ^api/ai/config/?$ api/ai/config.json [L]
  RewriteRule ^api/health/?$ api/health.json [L]
  RewriteRule ^api/admin/session/?$ api/admin-session.json [L]
  # Service « Créateurs » (PHP + SQLite) : fichier.php/<id>/… utilise PATH_INFO, donc on laisse Apache résoudre
  RewriteRule ^api/createurs/ - [L]
  # Lot 5 : badge SVG public (/api/badge.php?slug=…), servi par le service Créateurs
  RewriteRule ^api/badge\.php$ api/createurs/badge.php [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/ - [R=404,L]

  # Pages de la vitrine : elles n'existent que sur alphabette.fr
  RewriteRule ^(kit-seniors|site-vitrine|manifeste|ia-debat|service-france|info-perso|devenir-createur|dossier-de-presse)(/.*)?$ https://alphabette.fr/$1/ [R=301,L]

  # Applications, fichiers du laboratoire, applis hébergées des créateurs (bac à sable) et rapports de l'atelier : servis tels quels
  RewriteRule ^(apps|labo|createurs|atelier)/ - [L]

  # Créateurs (alphabette.eu) : page d'un créateur, cadre isolé d'une appli, lien de transfert, console d'administration
  RewriteRule ^createur/([a-z0-9-]{3,30})/?$ api/createurs/createur.php?handle=$1 [L,QSA]
  RewriteRule ^c/(c-[a-f0-9]{8})/?$ api/createurs/app.php?id=$1 [L,QSA]
  RewriteRule ^creations/valider-transfert/?$ api/createurs/transfert.php [L,QSA]
  RewriteRule ^admin/(validations|avis-suspects)/?$ admin-createurs.html [L]

  # Lot 5 : liens recommandés sans traceur, essai 7 jours, invitation d'un ami, lettre d'information (administration)
  RewriteRule ^go/([a-z0-9][a-z0-9-]{0,62})/?$ api/affiliation.php?go=$1 [L,QSA]
  RewriteRule ^essai/[a-z0-9][a-z0-9-]{0,62}/?$ essai/index.html [L]
  RewriteRule ^invite/r[a-z0-9]{10}/?$ invite/index.html [L]
  RewriteRule ^admin/newsletter/?$ admin-newsletter.html [L]

  # Application monopage : toute autre adresse renvoie index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
