{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/sync-covers.mjs --strict && bun run build:audio && bun run build:pop && bun run build:votes && bun run build:lot6 && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:static": "bun run build && node scripts/sync-covers.mjs && node scripts/build-static.mjs && node scripts/collect-apps.mjs && node scripts/nutri-meta.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "new:app": "tsx scripts/create-app.ts",
    "sync:shell": "tsx scripts/sync-shell.ts",
    "labo:cycle": "node scripts/labo/cycle.mjs",
    "labo:atelier": "node scripts/labo/atelier.mjs controler",
    "test:atelier": "node tests/atelier/test_atelier.mjs",
    "test": "bun run test:atelier && bun run test:lot6 && bun run test:covers && bun run test:laboratoire && bun run test:octet && bun run test:info",
    "test:laboratoire": "node tests/laboratoire/test_laboratoire.mjs",
    "test:info": "node tests/info-actualites/test_actualites.mjs",
    "test:octet": "bun tests/octet/test_octet.mjs",
    "build:audio": "esbuild packages/shell/src/audio/navigateur.ts --bundle --format=iife --minify --target=es2019 --outfile=public/assets/alphabette-audio.js",
    "build:pop": "esbuild packages/shell/src/pop/navigateur.ts --bundle --format=iife --minify --target=es2019 --outfile=public/assets/alphabette-effets.js && esbuild packages/shell/src/pop/pop.css --minify --outfile=public/assets/alphabette-pop.css",
    "build:votes": "esbuild packages/shell/src/labo/votesNavigateur.ts --bundle --format=iife --minify --target=es2019 --outfile=public/assets/alphabette-votes.js",
    "test:createurs": "python3 tests/createurs/test_createurs.py",
    "test:lot5": "python3 tests/lot5/test_lot5.py",
    "audit:lot5": "node scripts/audit-lot5.mjs",
    "build:lot6": "esbuild packages/shell/src/lot6-navigateur.ts --bundle --format=iife --minify --target=es2019 --outfile=public/assets/alphabette-lot6.js",
    "check:a11y": "node scripts/check-a11y.mjs",
    "test:lot6": "node tests/lot6/test_lot6.mjs",
    "covers:sync": "node scripts/sync-covers.mjs",
    "covers:ensure": "node scripts/ensure-app-cover.mjs",
    "test:covers": "node tests/covers/test_covers.mjs",
    "nutri": "node scripts/nutri-meta.mjs"
  },
  "dependencies": {
    "@alphabette/shell": "workspace:*",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dexie": "^4.4.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
