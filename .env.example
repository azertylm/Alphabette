# GEMINI_API_KEY: Required for Gemini AI API calls during prototype validation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- ARCHITECTURE IA SOUVERAINE ALPHABETTE (MISTRAL AI EXCLUSIF) ---
# Fournisseur actif: 'mistral_cloud' (production officielle) | 'hybrid_mistral' (Mac Metal/Local + secours Cloud) | 'local' | 'gemini'
AI_PROVIDER="mistral_cloud"

# Base URL standardisée pour l'IA
AI_BASE_URL="https://api.mistral.ai/v1"

# Clé API Mistral (Clé managée Alphabette ou Clé utilisateur BYOK)
AI_API_KEY=""
MISTRAL_API_KEY=""

# Modèle Mistral officiel recommandé
MISTRAL_MODEL="mistral-small-latest"
MISTRAL_CLOUD_MODEL="mistral-small-latest"

# Endpoint du serveur local (Développement local sous Mac Metal / Ollama)
LOCAL_AI_URL="http://localhost:11434"
LOCAL_AI_MODEL="mistral-nemo"
LOCAL_AI_TIMEOUT_MS="3500"

# URL du Hub Central
HUB_CENTRAL_URL="http://alphabette.fr"

# --- CONSOLE D'ADMINISTRATION /admin ---
# Mot de passe de la console d'administration (à définir impérativement pour ouvrir /admin)
ADMIN_PASSWORD=""
# Secret de signature des cookies de session (optionnel : sinon dérivé de ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=""

# --- COMMUNAUTE (comptes + galerie des pyramides) ---
# Secret de signature des sessions communauté.
# ATTENTION : s'il change (ou s'il est absent et régénéré au démarrage),
# tous les comptes publiés sont déconnectés.
COMMUNITY_SESSION_SECRET=""
