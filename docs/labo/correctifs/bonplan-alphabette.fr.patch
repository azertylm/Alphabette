From 3f321f232a725429160ca46f3fdeb5d3e410210a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 08:29:00 +0000
Subject: [PATCH] Labo : correctifs de l'Agent Chaos du 19/11/2026

---
 index.html | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/index.html b/index.html
index 332038b..cdd5c12 100644
--- a/index.html
+++ b/index.html
@@ -318,12 +318,16 @@ header {
   .tip-card { flex-direction: column; }
   .tip-vote-col { flex-direction: row; justify-content: space-between; padding: 12px 20px; border-right: none; border-bottom: 1px solid var(--border); }
   .vote-score { margin: 0 16px; }
-  .cats-grid { grid-template-columns: repeat(4,1fr); gap: 14px; padding: 0 16px 70px; }
+  .cats-grid { grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; padding: 0 16px 70px; }
   .disc { width: 60px; height: 60px; font-size: 22px; }
   .hero { padding: 44px 20px 32px; }
   .form-row { grid-template-columns: 1fr; }
   .toolbar { flex-direction: column; align-items: flex-start; }
 }
+/* Petits téléphones (320 px et moins) : 3 pastilles par ligne, aucun défilement de côté. */
+@media (max-width:360px) {
+  .cats-grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; padding: 0 12px 70px; }
+}
 /* Barre propre à BonPlan (sous la double barre Alphabette) */
 .bp-barre { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; padding: 8px 14px; background: var(--surface); border-bottom: 1px solid var(--border2); position: relative; z-index: 5; }
 .bp-barre .logo { cursor: pointer; margin-right: auto; font-size: 22px; line-height: 1; }
-- 
