# Généré par scripts/build-static.mjs — ne pas modifier à la main.
Options -Indexes -MultiViews
DirectoryIndex index.html
# Page 404 illustrée (Lot 4) : adresses de fichiers introuvables (apps/, labo/, api/…).
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=60"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Jeton « Authorization: Bearer » transmis à PHP (espace créateurs, api/billing.php…) : OVH le retire sinon.
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # HTTPS partout
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Une seule adresse pour le Laboratoire (référencement) : www.alphabette.eu → alphabette.eu
  RewriteCond %{HTTP_HOST} ^www\.alphabette\.eu$ [NC]
  RewriteRule ^(.*)$ https://alphabette.eu/$1 [R=301,L]

  # Laboratoire : alphabette.eu est servi depuis le dossier eu/.
  # Chez OVH, une réécriture vers eu/ ne repasse pas par eu/.htaccess quand la cible n'existe pas :
  # les adresses de l'API figée pointent donc directement sur leur fichier.
  RewriteCond %{HTTP_HOST} ^(www\.)?alphabette\.eu$ [NC]
  RewriteRule ^api/apps/?$ eu/api/apps.json [L]
  RewriteCond %{HTTP_HOST} ^(www\.)?alphabette\.eu$ [NC]
  RewriteRule ^api/ai/config/?$ eu/api/ai/config.json [L]
  RewriteCond %{HTTP_HOST} ^(www\.)?alphabette\.eu$ [NC]
  RewriteRule ^api/health/?$ eu/api/health.json [L]
  RewriteCond %{HTTP_HOST} ^(www\.)?alphabette\.eu$ [NC]
  RewriteRule ^api/admin/session/?$ eu/api/admin-session.json [L]
  RewriteCond %{HTTP_HOST} ^(www\.)?alphabette\.eu$ [NC]
  RewriteRule ^api/donnees-privees - [F,L]
  # Carte Collector d'un créateur (Lot 4) : pseudos hors service Créateurs (majuscules, « _ », 1-2 caractères) ;
  # les autres passent par eu/.htaccess → createur.php, qui affiche la Carte Collector s'il ne connaît pas le pseudo (Lot 5).
  RewriteCond %{HTTP_HOST} ^(www\.)?alphabette\.eu$ [NC]
  RewriteCond %{REQUEST_URI} !^/createur/[a-z0-9-]{3,30}/?$
  RewriteRule ^createur/[A-Za-z0-9_-]{1,40}/?$ eu/createur/index.html [L]
  RewriteCond %{HTTP_HOST} ^(www\.)?alphabette\.eu$ [NC]
  RewriteCond %{REQUEST_URI} !^/eu/
  RewriteRule ^(.*)$ eu/$1 [L]

  # Applications en test : leur adresse en .fr renvoie vers le Laboratoire (302 : provisoire)
  RewriteCond %{HTTP_HOST} ^(www\.)?alphabette\.fr$ [NC]
  RewriteRule ^(info\.html|quiz-femmes|quiz-extraordinaires|dico-loufoque|juste-chiffre|memo-meninges|orbit|ou-cest|ou-cest-france|petits-jeux|podcasts|quiz-famille|quiz-musique)(/.*)?$ https://alphabette.eu/$1$2 [R=302,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?alphabette\.fr$ [NC]
  RewriteRule ^apps/(bonplan|goatchevretheking|revolution|promptmagic|ecobatisol|frigoplacard|bonplansenior|atelier|proxilien|radar|lecturemagique|memovoix|matchsoiree|parentsos|revisclash|negocoach|disstrackexpress|tribunaldespotes|balade|tribunaldeschoix|alphabettehub|unedelabsurde|curioz|omnistat)(/.*)?$ https://alphabette.eu/apps/$1$2 [R=302,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?atelier\.alphabette\.fr$ [NC]
  RewriteRule ^(.*)$ https://alphabette.eu/apps/atelier/$1 [R=302,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?proxilien\.alphabette\.fr$ [NC]
  RewriteRule ^(.*)$ https://alphabette.eu/apps/proxilien/$1 [R=302,L]

  # Domaines en redirection vers le domaine principal de leur application
  # proxilien : proxilien.eu → proxilien.fr
  RewriteCond %{HTTP_HOST} ^(www\.)?(proxilien\.eu)$ [NC]
  RewriteRule ^(.*)$ https://proxilien.fr/$1 [R=301,L]

  # Domaines propres des applications (aiguillage par nom d'hôte)
  # infosperso : infosperso.alphabette.fr
  RewriteCond %{HTTP_HOST} ^(www\.)?(infosperso\.alphabette\.fr)$ [NC]
  RewriteCond %{REQUEST_URI} !^/apps/infosperso/
  RewriteRule ^(.*)$ apps/infosperso/$1 [L]

  # iadebat : iadebat.alphabette.fr
  RewriteCond %{HTTP_HOST} ^(www\.)?(iadebat\.alphabette\.fr)$ [NC]
  RewriteCond %{REQUEST_URI} !^/apps/iadebat/
  RewriteRule ^(.*)$ apps/iadebat/$1 [L]

  # atelier : atelier.alphabette.fr
  RewriteCond %{HTTP_HOST} ^(www\.)?(atelier\.alphabette\.fr)$ [NC]
  RewriteCond %{REQUEST_URI} !^/apps/atelier/
  RewriteRule ^(.*)$ apps/atelier/$1 [L]

  # proxilien : proxilien.fr, proxilien.alphabette.fr
  RewriteCond %{HTTP_HOST} ^(www\.)?(proxilien\.fr|proxilien\.alphabette\.fr)$ [NC]
  RewriteCond %{REQUEST_URI} !^/apps/proxilien/
  RewriteRule ^(.*)$ apps/proxilien/$1 [L]

  # Lot 5 : liens recommandés et badge depuis alphabette.fr → service du Laboratoire (aucun cookie)
  RewriteRule ^go/([a-z0-9][a-z0-9-]{0,62})/?$ https://alphabette.eu/go/$1?site=fr [R=302,L,QSA]
  RewriteRule ^api/badge\.php$ https://alphabette.eu/api/badge.php [R=302,L,QSA]

  # Continuité des anciennes adresses
  RewriteRule ^goat(/.*)?$ https://alphabette.eu/apps/goatchevretheking$1 [R=302,L]

  # API publique figée au build
  RewriteRule ^api/apps/?$ api/apps.json [L]
  RewriteRule ^api/ai/config/?$ api/ai/config.json [L]
  RewriteRule ^api/health/?$ api/health.json [L]
  RewriteRule ^api/admin/session/?$ api/admin-session.json [L]

  # Le reste de l'API (écriture, IA, admin) n'existe pas en statique
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/ - [R=404,L]

  # Applications publiées dans apps/<clé>/ : servies telles quelles
  RewriteRule ^apps/ - [L]

  # Application monopage : toute autre adresse renvoie index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
